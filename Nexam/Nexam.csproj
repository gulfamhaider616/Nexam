<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Nexam</RootNamespace>
    <AssemblyName>Nexam</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <UserSecretsId>9e2b85ae-3749-4144-8e10-0b1584b58588</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Legacy attach-file database from the .NET Framework version; kept for reference, not part of the build -->
    <None Include="App_Data\**" />
    <Content Remove="App_Data\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="IronPdf" Version="2026.11.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
  </ItemGroup>

</Project>
