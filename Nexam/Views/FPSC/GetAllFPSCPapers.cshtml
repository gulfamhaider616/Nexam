@model IEnumerable<Paper>
@{
	ViewBag.Title = "Nexam | FPSC Past Papers";
	ViewBag.Description = "FPSC Past Papers are available here. Online Nexam measures your improvement against the exam requirement and provides you with constant feedback and guidance....";
	ViewBag.KeyWords = "FPSC Past Paper,All Past Papers, FPSC Past Papers,Add Question,Terms and conditions,Question,Subjects,nexam contact,Contact,Nexam,About nexam,MCQ,MCQS,CSS,FPSC,PPSC,MCQ Preperation,General Knowledge,Pak study,Islamic Study,PAK AFFAIRS,MATHEMATIC,INTERNATIONAL AFFAIRS,COMPUTER SCIENCE,ENGLISH,GEOGRAPHY";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

@await Html.PartialAsync("_PaperList", new PaperListModel("FPSC Past Papers",
    Model.Select(p => new PaperCardModel(p, Url.Content("~/FPSC-Past-Paper-Question/" + p.PaperID), "FPSC", "Exam: FPSC"))))
