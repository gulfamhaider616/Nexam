@{
	ViewBag.Title = "FPSC_Home";
	Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


<div class="main_bg">
	<!-- start main -->
	<div class="container">
		<div class="main row" style="text-align:center;margin: auto;width: 70%;">
			<div class="col-md-4 images_1_of_4 text-center" style="border: 1px solid #ff5454;border-radius: 10px;">
				<h4><a href="/FPSC/NewFPSCPaper">ADD New FPSC Paper</a></h4>
