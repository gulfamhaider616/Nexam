@{
    ViewBag.Title = "FPSC_Home";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-head">
    <h1>FPSC papers</h1>
    <p>Manage FPSC past papers and their questions.</p>
</div>

<div class="admin-tiles">
    <a class="admin-tile" href="/FPSC/NewFPSCPaper">
        <span class="tile"><svg class="icon" aria-hidden="true"><use href="#i-plus"/></svg></span>
        <div><h3>Add new FPSC paper</h3><p>Create a new FPSC paper.</p></div>
    </a>
    <a class="admin-tile" href="/FPSC/NewFPSCQuestion">
        <span class="tile"><svg class="icon" aria-hidden="true"><use href="#i-edit"/></svg></span>
        <div><h3>Add new FPSC question</h3><p>Add an MCQ to an existing paper.</p></div>
    </a>
    <a class="admin-tile" href="/FPSC/GetAllFPSCPapersByAdmin">
        <span class="tile"><svg class="icon" aria-hidden="true"><use href="#i-file-text"/></svg></span>
        <div><h3>All FPSC papers</h3><p>Browse papers and manage questions.</p></div>
    </a>
</div>
