@{
    ViewBag.Title = "NewFPSCPaper";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-head">
    <h1>Add new FPSC paper</h1>
    <p>Create a paper, then add its questions.</p>
    <div class="cluster"><a class="btn btn-secondary btn-sm" href="/FPSC/FPSC_Home">Back to FPSC</a></div>
</div>

<form class="form-card" action="/FPSC/SaveFPSCNewPaper" method="post" style="max-width:720px">
    <div class="form-grid">
        <div class="field">
            <label for="paper-name">Paper name</label>
            <input class="input" type="text" id="paper-name" name="name" dir="auto" placeholder="Enter paper name" required>
        </div>
        <div class="field">
            <label for="paper-detail">Paper detail</label>
            <input class="input" type="text" id="paper-detail" name="detail" dir="auto" placeholder="Enter one line paper detail">
        </div>
    </div>
    <div class="form-actions">
        <button class="btn btn-primary" type="submit">Submit</button>
        <a class="btn btn-ghost" href="/FPSC/GetAllFPSCPapersByAdmin">Cancel</a>
    </div>
</form>
