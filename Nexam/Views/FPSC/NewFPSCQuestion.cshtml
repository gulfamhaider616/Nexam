@model IEnumerable<Paper>
@{
    ViewBag.Title = "NewFPSCQuestion";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-head">
    <h1>Add new FPSC question</h1>
    <p>Pick the paper, then enter the question, its comma-separated choices and the correct answer.</p>
    <div class="cluster"><a class="btn btn-secondary btn-sm" href="/FPSC/FPSC_Home">Back to FPSC</a></div>
</div>

<form class="form-card" action="/FPSC/SaveNewFPSCQuestion" method="post" style="max-width:720px">
    <div class="form-grid">
        <div class="field">
            <label for="q-paper">Paper</label>
            <select class="select" id="q-paper" name="paperid">
                @foreach (var Item in Model)
                {
                    <option value="@Item.PaperID">@Item.PaperName</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="q-statement">Question statement</label>
            <textarea class="textarea" id="q-statement" name="questionstatement" dir="auto" rows="3" placeholder="For inline only add question statement" required></textarea>
        </div>
        <div class="field">
            <label for="q-choices">Choices</label>
            <input class="input" type="text" id="q-choices" name="choices" dir="auto" placeholder="Enter comma separated choices">
            <span class="help">Separate each choice with a comma.</span>
        </div>
        <div class="field">
            <label for="q-answer">Correct answer</label>
            <input class="input" type="text" id="q-answer" name="correctanswer" dir="auto" placeholder="Enter correct answer">
        </div>
    </div>
    <div class="form-actions">
        <button class="btn btn-primary" type="submit">Submit</button>
        <a class="btn btn-ghost" href="/FPSC/FPSC_Home">Cancel</a>
    </div>
</form>
