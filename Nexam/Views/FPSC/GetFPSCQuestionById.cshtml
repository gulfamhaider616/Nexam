@model Question
@{
    ViewBag.Title = "Nexam | FPSC Paper Questions";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-head">
    <h1>Edit question</h1>
    <p>Update the question text, choices and correct answer.</p>
    <div class="cluster">
        @if (Model.PaperID != 0)
        {
            <a class="btn btn-secondary btn-sm" href="/FPSC/GetAllFPSCQuestionsByPaperIDAdmin?paperid=@Model.PaperID">Back to paper</a>
        }
        else
        {
            <a class="btn btn-secondary btn-sm" href="/FPSC/GetAllFPSCPapersByAdmin">Back to papers</a>
        }
    </div>
</div>

<form class="form-card" action="/Admin/SaveEditQuestion" method="post" style="max-width:760px">
    <input type="hidden" name="questionid" value="@Model.QuestionID">
    <div class="form-grid">
        <div class="field">
            <label for="e-paper">Paper</label>
            <select class="select" id="e-paper" name="subjectid">
                <option value="@Model.PaperID">@Model.PaperName</option>
            </select>
        </div>
        <div class="field">
            <label for="e-statement">Question statement</label>
            <textarea class="textarea" id="e-statement" name="questionstatement" dir="auto" rows="3">@Model.QuestionStatement</textarea>
        </div>
    </div>
    <div class="form-grid cols-2">
        <div class="field">
            <label for="e-count">Total choices</label>
            <input class="input" type="number" min="0" id="e-count" name="numberofchoices" value="@Model.NumberOfChoices">
        </div>
        <div class="field">
            <label for="e-answer">Correct answer</label>
            <input class="input" type="text" id="e-answer" name="correctanswer" dir="auto" value="@Model.CorrectAnswer">
        </div>
    </div>
    <div class="form-grid">
        <div class="field">
            <label for="e-choices">Choices</label>
            <input class="input" type="text" id="e-choices" name="choices" dir="auto" value="@Model.Choices">
            <span class="help">Separate each choice with a comma.</span>
        </div>
    </div>
    <div class="form-actions">
        <button class="btn btn-primary" type="submit">Save changes</button>
        <a class="btn btn-ghost" href="/FPSC/GetAllFPSCPapersByAdmin">Cancel</a>
    </div>
</form>
