    <div class="row">
        <div class="col-1"></div>
        <div class="col-10">
            <div class="questions-container" data-id="@Model.QuizID">
                @{ int counter = 1;
                    foreach (var Item in Model.QuestionsDOs)
                    {
                        <div class="card exam-question-card" style="margin: 5px 0 5px 0; box-shadow: rgba(0, 0, 0, 0.35) 0px 5px 15px;">
                            <div class="card-header text-white" style="background-color: #21a7d0;">
                                Question No.@counter
                            </div>
                            <div class="card-body question-body" data-id="@Item.QuestionID">
                                <p class="card-text">
                                    @Item.QuestionStatement<br>
                                </p>
                                <div class="question-choices-container">
                                    <div class="voted-answers-tally d-none">

                                        <script id="730349" type="application/json">[{"voted_answers": "A", "vote_count": 2, "is_most_voted": false}]</script>

                                    </div>
                                    <ul>
                                        @{
                                            if (Item.Choices != null)
                                            {
                                                var choices = Item.Choices.Split(',');
                                                foreach (var choice in choices)
                                                {
                                                <li class="multi-choice-item">
                                                    <input type="radio" value='@choice' name="@Item.QuestionID">
                                                    <label>@choice</label>
                                                </li>
                                                    }
                                                }
else
                {
                    <input type="text" />
                }
                                            }
                                        
                                    </ul>
                                </div>

                                @*exam-view410
                                <a href="#" class="btn btn-primary reveal-solution d-print-none">Reveal Solution</a>
                                <a href="#" class="btn btn-primary hide-solution d-none d-print-none">Hide Solution</a>
                                <a href="#" class="btn btn-secondary question-discussion-button d-print-none">
                                    <i class="fa fa-comment"></i>
                                    &nbsp; Discussion &nbsp;

                                    <span class="badge badge-pill badge-light">24</span>
                                </a>*@
                                <p class="card-text question-answer bg-light white-text" hidden>
                                    <span class="correct-answer-box">
                                        <strong>Correct Answer:</strong>
                                        <span class="correct-answer">@Item.CorrectAnswer</span>
                                    </span>
                                </p>
                            </div>
                        </div>

                        counter++;
                    }
                }
            </div>
            <div class="page-navigation-bar">
                <div class="col-12" style="text-align: end;">
                    <br />
                    <button id='btnSave' class="btn btn-primary">Submit Quiz</button>
                    <br /><br />
                </div>
            </div>
        </div>
        <div class="col-1"></div>
    </div>
    </div>

   

