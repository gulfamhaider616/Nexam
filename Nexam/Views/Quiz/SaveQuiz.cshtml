    <div class="container">
        <div class="exam-view-header">

            <div class="row">
                <div class="col-12 col-sm-8 offset-sm-2 d-print-none">
                </div>
            </div>
            <div class="row d-print-none" style="padding-bottom: 10px;padding-top: 10px;">
                <div class="col-lg-6 offset-lg-3">

                    <div class="card">
                        <div class="card-header alert alert-info text-center">
                            <h2 id="exam-box-title">
                               PPSC Exam Practice Quiz
                            </h2>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">
                                SUBJECT: @Model.QuestionsDOs[0].SubjectName
                            </h5>
                            <div class="card-text">
                                <ul>

                                    <li>
                                        Total Questions: @Model.QuestionsDOs.Count
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    @*<div class="disclaimer-box mt-2">
