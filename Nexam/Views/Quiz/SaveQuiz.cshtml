@model QuizSubmission
@{
    ViewBag.Title = "Nexam | Quiz";
    ViewBag.Description = "Answer the questions and submit your Nexam practice quiz to see your score.";
    ViewBag.KeyWords = "Nexam quiz, practice quiz, MCQs quiz";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var questions = Model?.QuestionsDOs ?? new List<Question>();
    var subjectName = questions.Count > 0 ? questions[0].SubjectName : null;
    var number = 1;
}
@section Head {
    <link rel="stylesheet" href="/css/pages-user.css">
}

<div class="container container-narrow">
    <div class="page-head">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/Quiz/QuizHome">Quiz</a><span>/</span><span aria-current="page">Practice quiz</span></nav>
        <h1>PPSC Exam Practice Quiz</h1>
        @if (questions.Count > 0)
        {
            <div class="cluster">
                <span class="badge">@subjectName</span>
                <span class="badge badge-muted">@questions.Count questions</span>
            </div>
        }
    </div>

    @if (questions.Count == 0)
    {
        <div class="section" style="padding-top:20px">
            <div class="empty">
                <svg class="icon" aria-hidden="true"><use href="#i-inbox"/></svg>
                <p>We could not find any questions for this quiz. Please try a different subject.</p>
                <a class="btn btn-primary" href="/Quiz/NewQuiz">Start a new quiz</a>
            </div>
        </div>
    }
    else
    {
        <div class="quiz-progress">
            <div class="bar" role="progressbar" aria-label="Quiz progress" aria-valuemin="0" aria-valuemax="@questions.Count" aria-valuenow="0" data-progress-bar><span></span></div>
            <small data-progress-text>0 of @questions.Count answered</small>
        </div>

        <div class="questions-container q-list" data-id="@Model.QuizID">
            @foreach (var item in questions)
            {
                <article class="q-card" data-question data-id="@item.QuestionID" data-correct="@item.CorrectAnswer">
                    <div class="q-head"><span class="q-num">@number</span><span class="muted">Question @number of @questions.Count</span></div>
                    <p class="q-text" dir="auto">@item.QuestionStatement</p>
                    <fieldset class="q-options">
                        <legend class="sr-only">Choose one answer for question @number</legend>
                        @if (!string.IsNullOrWhiteSpace(item.Choices))
                        {
                            foreach (var choice in item.Choices.Split(','))
                            {
                                var text = choice.Trim();
                                if (text.Length == 0) { continue; }
                                <label class="choice"><input type="radio" name="@item.QuestionID" value="@text"><span dir="auto">@text</span></label>
                            }
                        }
                        else
                        {
                            <input class="input" type="text" name="@item.QuestionID" aria-label="Your answer to question @number" placeholder="Type your answer" dir="auto">
                        }
                    </fieldset>
                </article>
                number++;
            }
        </div>

        <div class="quiz-submit">
            <div class="cluster" style="justify-content:space-between">
                <span class="muted" data-progress-text-footer>0 of @questions.Count answered</span>
                <button id="btnSave" class="btn btn-primary btn-lg" type="button"><svg class="icon" aria-hidden="true"><use href="#i-check"/></svg>Submit quiz</button>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="/js/quiz.js"></script>
}
