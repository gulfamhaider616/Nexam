@{
    ViewBag.Title = "Nexam | Practice Quiz";
    ViewBag.Description = "Take a choice based practice quiz on Nexam. Pick a subject and the number of questions, then see your result with feedback.";
    ViewBag.KeyWords = "Nexam quiz, MCQs quiz, PPSC quiz, practice test, online quiz";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var signedIn = User.IsInRole("User");
}
@section Head {
    <link rel="stylesheet" href="/css/pages-user.css" asp-append-version="true">
}

<div class="container container-narrow">
    <div class="page-head">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span aria-current="page">Quiz</span></nav>
        <h1>Welcome to Nexam Quiz System</h1>
        <p>Practice with choice based quizzes and keep track of your progress.</p>
    </div>

    <div class="section" style="padding-top:20px">
        <ol class="rules">
            <li>NEXAM provides choice based quiz. You can select Subject and No. of Questions according to your choice.</li>
            <li>Each time, you will see different set of questions. We will keep your progress record for your evaluation.</li>
            <li>We have a huge database collection to make your perfect preparation with practice.</li>
            <li>After completing your quiz, you will see your result with System Feedback.</li>
        </ol>

        <div class="panel disclaimer mt-3">
            <strong>Disclaimers:</strong>
            <ul>
                <li>NEXAM website is not affiliated with, endorsed or authorized by PPSC.</li>
                <li>Trademarks, certification &amp; product names are used for reference only.</li>
            </ul>
        </div>

        <div class="text-center mt-4">
            <a class="btn btn-primary btn-lg" href="/Quiz/NewQuiz"><svg class="icon" aria-hidden="true"><use href="#i-quiz"/></svg>Start a quiz</a>
            @if (!signedIn)
            {
                <p class="muted mt-2 mb-0">You need an account to take a quiz. <a href="/Login">Log in</a> or <a href="/User/User_Registration">create one</a>.</p>
            }
        </div>
    </div>
</div>
