@model Quiz
@{
    ViewBag.Title = "Nexam | Quiz Result";
    ViewBag.Description = "Review your Nexam practice quiz: your score and the correct answers.";
    ViewBag.KeyWords = "Nexam quiz result, quiz review, MCQs";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var items = Model?.quizQuestionDOs ?? new List<QuizQuestion>();
    var first = items.Count > 0 ? items[0] : null;
    var correctCount = items.Count(x => x.IsCorrect);
    var number = 1;
    bool Same(string a, string b) => string.Equals((a ?? "").Trim(), (b ?? "").Trim(), StringComparison.Ordinal);
}
@section Head {
    <link rel="stylesheet" href="/css/pages-user.css" asp-append-version="true">
}

<div class="container container-narrow">
    <div class="page-head">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/User/UserDashboard">My quizzes</a><span>/</span><span aria-current="page">Quiz result</span></nav>
        <h1>PPSC Exam Practice Quiz</h1>
        @if (first != null && !string.IsNullOrWhiteSpace(first.Title))
        {
            <p>@first.Title</p>
        }
    </div>

    @if (first == null)
    {
        <div class="section" style="padding-top:20px">
            <div class="empty">
                <svg class="icon" aria-hidden="true"><use href="#i-inbox"/></svg>
                <p>We could not find this quiz.</p>
                <a class="btn btn-primary" href="/User/UserDashboard">Back to my quizzes</a>
            </div>
        </div>
    }
    else
    {
        <div class="section" style="padding-top:20px">
            <div class="panel review-summary">
                <h2>@first.Subject</h2>
                <div class="stat-grid mt-2 mb-0">
                    <div class="stat"><strong>@first.Score%</strong><span>Your score</span></div>
                    <div class="stat"><strong>@correctCount / @items.Count</strong><span>Correct answers</span></div>
                    <div class="stat"><strong>@items.Count</strong><span>Total questions</span></div>
                </div>
            </div>

            <div class="q-list">
                @foreach (var item in items)
                {
                    var answered = !string.IsNullOrWhiteSpace(item.UserAnswer);
                    <article class="q-card">
                        <div class="q-head">
                            <span class="q-num">@number</span>
                            @if (item.IsCorrect)
                            {
                                <span class="badge badge-success">Correct</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">@(answered ? "Incorrect" : "Not answered")</span>
                            }
                        </div>
                        <p class="q-text" dir="auto">@item.QuestionStatement</p>
                        <div class="q-options review">
                            @if (!string.IsNullOrWhiteSpace(item.Choices))
                            {
                                foreach (var choice in item.Choices.Split(','))
                                {
                                    var text = choice.Trim();
                                    if (text.Length == 0) { continue; }
                                    var isCorrect = Same(text, item.CorrectAnswer);
                                    var isMine = answered && Same(text, item.UserAnswer);
                                    var state = isCorrect ? "is-correct" : (isMine ? "is-wrong" : "");
                                    <div class="choice @state">
                                        @if (isCorrect)
                                        {
                                            <svg class="icon" aria-hidden="true"><use href="#i-check"/></svg>
                                        }
                                        else if (isMine)
                                        {
                                            <svg class="icon" aria-hidden="true"><use href="#i-close"/></svg>
                                        }
                                        else
                                        {
                                            <span class="dot" aria-hidden="true"></span>
                                        }
                                        <span dir="auto">@text</span>
                                        @if (isCorrect && isMine)
                                        {
                                            <span class="badge badge-success tag">Your answer</span>
                                        }
                                        else if (isCorrect)
                                        {
                                            <span class="badge badge-success tag">Correct answer</span>
                                        }
                                        else if (isMine)
                                        {
                                            <span class="badge badge-danger tag">Your answer</span>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="choice @(item.IsCorrect ? "is-correct" : "is-wrong")">
                                    <span dir="auto">Your answer: @(answered ? item.UserAnswer : "not answered")</span>
                                </div>
                            }
                        </div>
                        @if (!item.IsCorrect)
                        {
                            <p class="q-answer">Correct answer: <span dir="auto">@item.CorrectAnswer</span></p>
                        }
                    </article>
                    number++;
                }
            </div>

            <div class="form-actions mt-4">
                <a class="btn btn-primary" href="/Quiz/NewQuiz"><svg class="icon" aria-hidden="true"><use href="#i-quiz"/></svg>Take another quiz</a>
                <a class="btn btn-secondary" href="/User/UserDashboard">Back to my quizzes</a>
            </div>
        </div>
    }
</div>
