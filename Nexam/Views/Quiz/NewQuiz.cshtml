@model IEnumerable<Subject>
@{
    ViewBag.Title = "Nexam | New Quiz";
    ViewBag.Description = "Choose a subject and the number of questions to start a new practice quiz on Nexam.";
    ViewBag.KeyWords = "Nexam quiz, new quiz, MCQs quiz, PPSC quiz, practice test";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    <link rel="stylesheet" href="/css/pages-user.css">
}

<div class="container container-narrow">
    <div class="page-head">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/Quiz/QuizHome">Quiz</a><span>/</span><span aria-current="page">New quiz</span></nav>
        <h1>Please fill your quiz information</h1>
        <p>Pick a subject and how many questions you want to practise.</p>
    </div>

    <div class="section" style="padding-top:20px">
        <form class="form-card" method="post" action="/Quiz/SaveQuiz">
            <div class="field">
                <label for="title">Quiz title</label>
                <input class="input" type="text" id="title" name="title" placeholder="e.g. My first practice quiz" maxlength="120" required>
            </div>
            <div class="form-grid cols-2">
                <div class="field">
                    <label for="subjectid">Subject</label>
                    <select class="select" id="subjectid" name="subjectid" required>
                        @foreach (var item in Model)
                        {
                            <option value="@item.SubjectID">@item.SubjectName</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="totalquestions">Number of questions</label>
                    <select class="select" id="totalquestions" name="totalquestions">
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="15">15</option>
                        <option value="20">20</option>
                    </select>
                </div>
            </div>
            <div class="field">
                <label class="check"><input type="checkbox" name="CHKBOX1" id="CHKBOX1" value="1" required><span>You must agree with our <a href="/nexam/terms-conditions" target="_blank" rel="noopener">Terms and Conditions</a>.</span></label>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-lg"><svg class="icon" aria-hidden="true"><use href="#i-quiz"/></svg>Start quiz</button>
                <a class="btn btn-secondary btn-lg" href="/Quiz/QuizHome">Cancel</a>
            </div>
        </form>
    </div>
</div>
