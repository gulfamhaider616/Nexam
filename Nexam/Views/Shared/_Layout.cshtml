    <script>
        $(window).load(function () {
            var url = window.location.href;
            //alert(url)
            $('#menu li').find('.current').removeClass('current');
            $('#menu li a').filter(function () {
                //alert("href = " + this.href+", url ="+url)
                return this.href == url;
            }).parent().addClass('current-menu-item');
        });
    </script>

    <script type="text/javascript">
        $(".container").on("click", "#btnSave", function () {
            var questions = new Array();
            var quizquestioncontract = {};
            $(".questions-container .exam-question-card").each(function () {
                var row = $(this);
                var question = {};
                question.QuestionID = row.find(".question-body").attr("data-id");
                question.UserAnswer = row.find("li input:checked").val().trim();
                question.CorrectAnswer = row.find(".correct-answer").html();
                if (question.UserAnswer.trim() == question.CorrectAnswer.trim()) {
                    question.IsCorrect = true;
                }
                else {
                    question.IsCorrect = false;
                }
                questions.push(question);
            });
            quizquestioncontract.QuizQuestions = questions;
            quizquestioncontract.QuizID = $(".questions-container").attr("data-id");
            //Send the JSON array to Controller using AJAX.
            $.ajax({
                type: "POST",
                url: "/Quiz/InsertQuizQuestion",
                data: JSON.stringify(quizquestioncontract),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (result) {
                    $(".modal-title").html(result.Remarks + ", " + result.Name + "!");
                    $(".modal-body").html("Score:  " + result.Score);
                    $("#bsModal3").modal('show');
                },
                error: function () {
                    alert("Error");
                }
            });
        });
    </script>
