<!DOCTYPE html>
@{
    // Highlight the current section in the navigation.
    var path = (Context.Request.Path.Value ?? "/").ToLowerInvariant();
    string Cur(params string[] prefixes) => prefixes.Any(p => p == "/" ? path == "/" : path.StartsWith(p)) ? "page" : null;
    var isUser = User.IsInRole("User");
    var isAdmin = User.IsInRole("Admin");
}
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewBag.Title</title>
    <meta name="description" content="@ViewBag.Description">
    <meta name="keywords" content="@ViewBag.KeyWords">
    <meta name="theme-color" content="#2447d6">
    <meta name="google" content="notranslate">
    <link rel="icon" href="/images/nexam-mark.svg" type="image/svg+xml">
    <link rel="shortcut icon" href="~/trans-favicon.ico" type="image/x-icon">

    <script>
        // Apply the saved theme before first paint so there is no light/dark flash.
        (function () {
            var t = null;
            try { t = localStorage.getItem('nx-theme'); } catch (e) { }
            if (!t) t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            var q = new URLSearchParams(location.search).get('theme');   // ?theme=light|dark previews a theme without saving it
            if (q === 'light' || q === 'dark') t = q;
            document.documentElement.setAttribute('data-theme', t);
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Naskh+Arabic:wght@400;600&display=swap">
    <link rel="stylesheet" href="/css/nexam.css">
    @RenderSection("Head", required: false)

    <script async src="https://www.googletagmanager.com/gtag/js?id=UA-106794809-1"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments) };
        gtag('js', new Date());
        gtag('config', 'UA-106794809-1');
    </script>
</head>
<body>
    @await Html.PartialAsync("_Icons")
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
        <div class="container header-bar">
            <a class="brand" href="/" aria-label="Nexam home"><img src="/images/nexam-mark.svg" alt="" width="34" height="34">Nexam</a>

            <nav class="nav" aria-label="Main">
                <a href="/" aria-current="@Cur("/")">Home</a>
                <div class="nav-dd">
                    <button type="button" class="nav-dd-btn" aria-haspopup="true" aria-current="@Cur("/ppsc", "/nts", "/fpsc", "/css")">Papers</button>
                    <div class="nav-dd-panel">
                        <a href="/PPSC-Past-Papers">PPSC past papers</a>
                        <a href="/NTS-Past-Papers">NTS past papers</a>
                        <a href="/FPSC-Past-Papers">FPSC past papers</a>
                        <a href="/CSS-Past-Papers">CSS past papers</a>
                    </div>
                </div>
                <a href="/nexam/all-subjects" aria-current="@Cur("/nexam/all-subjects", "/questions", "/question-detail")">Subjects</a>
                <a href="/Quiz/QuizHome" aria-current="@Cur("/quiz")">Quiz</a>
                <a href="/Nexam-Forum" aria-current="@Cur("/nexam-forum", "/forum")">Forum</a>
                <a href="/nexam-about" aria-current="@Cur("/nexam-about")">About</a>
                <a href="/nexam-contact" aria-current="@Cur("/nexam-contact")">Contact</a>
                <a href="/nexam/terms-conditions" aria-current="@Cur("/nexam/terms-conditions")">Terms</a>
            </nav>

            <div class="header-actions">
                <form class="header-search" action="/Home/SearchResult" method="get" role="search">
                    <svg class="icon" aria-hidden="true"><use href="#i-search"/></svg>
                    <input class="input" type="search" name="search" placeholder="Search questions  ( / )" aria-label="Search questions" data-search-input>
                </form>

                <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark mode">
                    <svg class="icon icon-sun" aria-hidden="true"><use href="#i-sun"/></svg>
                    <svg class="icon icon-moon" aria-hidden="true"><use href="#i-moon"/></svg>
                </button>

                <div class="header-auth">
                    @if (isUser)
                    {
                        <a class="btn btn-ghost btn-sm" href="/User/UserDashboard"><svg class="icon" aria-hidden="true"><use href="#i-user"/></svg>@User.Identity.Name</a>
                        <a class="btn btn-secondary btn-sm" href="/Admin/Logout">Log out</a>
                    }
                    else if (isAdmin)
                    {
                        <a class="btn btn-ghost btn-sm" href="/Admin/GetAllSubjects"><svg class="icon" aria-hidden="true"><use href="#i-shield"/></svg>Admin</a>
                        <a class="btn btn-secondary btn-sm" href="/Admin/Logout">Log out</a>
                    }
                    else
                    {
                        <a class="btn btn-primary btn-sm" href="/User/UserLogin">Log in</a>
                    }
                </div>

                <button class="icon-btn menu-toggle" type="button" data-menu-toggle aria-label="Menu" aria-expanded="false" aria-controls="drawer">
                    <svg class="icon" aria-hidden="true"><use href="#i-menu"/></svg>
                </button>
            </div>
        </div>
    </header>

    <div class="drawer" id="drawer" data-open="false">
        <form action="/Home/SearchResult" method="get" role="search">
            <div class="field mb-0"><input class="input" type="search" name="search" placeholder="Search questions" aria-label="Search questions"></div>
        </form>
        <a class="drawer-link" href="/"><svg class="icon" aria-hidden="true"><use href="#i-home"/></svg>Home</a>
        <a class="drawer-link" href="/PPSC-Past-Papers"><svg class="icon" aria-hidden="true"><use href="#i-file-text"/></svg>PPSC past papers</a>
        <a class="drawer-link" href="/NTS-Past-Papers"><svg class="icon" aria-hidden="true"><use href="#i-file-text"/></svg>NTS past papers</a>
        <a class="drawer-link" href="/FPSC-Past-Papers"><svg class="icon" aria-hidden="true"><use href="#i-file-text"/></svg>FPSC past papers</a>
        <a class="drawer-link" href="/CSS-Past-Papers"><svg class="icon" aria-hidden="true"><use href="#i-file-text"/></svg>CSS past papers</a>
        <a class="drawer-link" href="/nexam/all-subjects"><svg class="icon" aria-hidden="true"><use href="#i-layers"/></svg>Subjects</a>
        <a class="drawer-link" href="/Quiz/QuizHome"><svg class="icon" aria-hidden="true"><use href="#i-quiz"/></svg>Quiz</a>
        <a class="drawer-link" href="/Nexam-Forum"><svg class="icon" aria-hidden="true"><use href="#i-message"/></svg>Forum</a>
        <a class="drawer-link" href="/nexam-about"><svg class="icon" aria-hidden="true"><use href="#i-info"/></svg>About</a>
        <a class="drawer-link" href="/nexam-contact"><svg class="icon" aria-hidden="true"><use href="#i-mail"/></svg>Contact</a>
        <a class="drawer-link" href="/nexam/terms-conditions"><svg class="icon" aria-hidden="true"><use href="#i-shield"/></svg>Terms</a>
        <div class="cluster">
            @if (isUser)
            {
                <a class="btn btn-secondary" href="/User/UserDashboard">@User.Identity.Name</a>
                <a class="btn btn-secondary" href="/Admin/Logout">Log out</a>
            }
            else if (isAdmin)
            {
                <a class="btn btn-secondary" href="/Admin/GetAllSubjects">Admin</a>
                <a class="btn btn-secondary" href="/Admin/Logout">Log out</a>
            }
            else
            {
                <a class="btn btn-primary" href="/User/UserLogin">Log in</a>
            }
        </div>
    </div>

    <main id="main">
        @RenderBody()
    </main>

    <script src="/js/nexam.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
