						<li><a href="/FPSC/FPSC_Home">FPSC</a></li>
						<li><a href="/CSS/CSS_Home">CSS</a></li>
						<li><a href="/Forum/ForumMainPage">Forum</a></li>
                        <li><a href="/Admin/GetContacts">Contact</a></li>
                        <li><a href="/Admin/Logout">Logout</a></li>
                    </ul>
                </div><!-- /.navbar-collapse -->
                <!-- start soc_icons -->
            </nav>
            @*<div class="soc_icons navbar-right">
                <ul class="list-unstyled text-center">
                    <li><a href="/Admin/Logout" style="font-size: 18px;color: white;">Logout</a></li>
                </ul>
            </div>*@
