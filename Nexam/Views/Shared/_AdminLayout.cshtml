                <div class="h_search navbar-right">
                    <form action="/Admin/AdminSearchResult" method="post">
                        <input type="text" name="search" class="text" value="Enter text here" onfocus="this.value = '';" onblur="if (this.value == '') {this.value = 'Enter text here';}">
                        <input type="submit" value="search">
                    </form>
                </div>
                <div class="clearfix"></div>
            </div>
        </div>
    </div>
    <div class="container">
