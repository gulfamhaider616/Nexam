<!DOCTYPE html>
@{
    var path = (Context.Request.Path.Value ?? "/").ToLowerInvariant();
    string Cur(params string[] prefixes) => prefixes.Any(p => path.StartsWith(p)) ? "page" : null;
}
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(ViewBag.Title ?? "Admin") | Nexam Admin</title>
    <meta name="robots" content="noindex">
    <meta name="theme-color" content="#2447d6">
    <link rel="icon" href="/images/nexam-mark.svg" type="image/svg+xml">

    <script>
        (function () {
            var t = null;
            try { t = localStorage.getItem('nx-theme'); } catch (e) { }
            if (!t) t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            var q = new URLSearchParams(location.search).get('theme');   // ?theme=light|dark previews a theme without saving it
            if (q === 'light' || q === 'dark') t = q;
            document.documentElement.setAttribute('data-theme', t);
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Naskh+Arabic:wght@400;600&display=swap">
    <link rel="stylesheet" href="/css/nexam.css">
    @RenderSection("Head", required: false)
</head>
<body>
    @await Html.PartialAsync("_Icons")
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="admin">
        <header class="admin-top">
            <div class="container header-bar" style="max-width:none">
                <a class="brand" href="/Admin/GetAllSubjects"><img src="/images/nexam-mark.svg" alt="" width="30" height="30">Nexam <span class="badge badge-amber">Admin</span></a>
                <div class="header-actions">
                    <form class="header-search" action="/Admin/AdminSearchResult" method="get" role="search">
                        <svg class="icon" aria-hidden="true"><use href="#i-search"/></svg>
                        <input class="input" type="search" name="search" placeholder="Search questions" aria-label="Search questions">
                    </form>
                    <a class="btn btn-ghost btn-sm" href="/" target="_blank" rel="noopener"><svg class="icon" aria-hidden="true"><use href="#i-external"/></svg><span class="hidden-sm">View site</span></a>
                    <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark mode">
                        <svg class="icon icon-sun" aria-hidden="true"><use href="#i-sun"/></svg>
                        <svg class="icon icon-moon" aria-hidden="true"><use href="#i-moon"/></svg>
                    </button>
                    <a class="btn btn-secondary btn-sm" href="/Admin/Logout"><svg class="icon" aria-hidden="true"><use href="#i-logout"/></svg>Log out</a>
                </div>
            </div>
        </header>

        <div class="admin-body">
            <nav class="admin-nav" aria-label="Admin">
                <span class="group-label">Content</span>
                <a href="/Admin/GetAllSubjects" aria-current="@Cur("/admin/getallsubjects", "/admin/getallquestionsbyadmin", "/admin/getquestionbyid", "/admin/adminsearchresult")"><svg class="icon" aria-hidden="true"><use href="#i-layers"/></svg>Subjects</a>
                <a href="/Admin/AddNewSubject" aria-current="@Cur("/admin/addnewsubject")"><svg class="icon" aria-hidden="true"><use href="#i-plus"/></svg>Add subject</a>
                <a href="/Admin/AddNewQuestion" aria-current="@Cur("/admin/addnewquestion")"><svg class="icon" aria-hidden="true"><use href="#i-plus"/></svg>Add question</a>
                <span class="group-label">Exams</span>
                <a href="/PPSC/PPSC_Home" aria-current="@Cur("/ppsc/")"><svg class="icon" aria-hidden="true"><use href="#i-file-text"/></svg>PPSC</a>
                <a href="/NTS/NTS_Home" aria-current="@Cur("/nts/")"><svg class="icon" aria-hidden="true"><use href="#i-file-text"/></svg>NTS</a>
                <a href="/FPSC/FPSC_Home" aria-current="@Cur("/fpsc/")"><svg class="icon" aria-hidden="true"><use href="#i-file-text"/></svg>FPSC</a>
                <a href="/CSS/CSS_Home" aria-current="@Cur("/css/")"><svg class="icon" aria-hidden="true"><use href="#i-file-text"/></svg>CSS</a>
                <span class="group-label">Community</span>
                <a href="/Forum/ForumMainPage" aria-current="@Cur("/forum/")"><svg class="icon" aria-hidden="true"><use href="#i-message"/></svg>Forum</a>
                <a href="/Admin/GetContacts" aria-current="@Cur("/admin/getcontacts")"><svg class="icon" aria-hidden="true"><use href="#i-inbox"/></svg>Contacts</a>
            </nav>

            <main class="admin-main" id="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="/js/nexam.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
