            <div class="row  footer">
                <div class="copy text-center">
                    <p class="link"><span>&#169; All rights reserved | Design by&nbsp;<a href="#"> Nexam.</a></span></p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>