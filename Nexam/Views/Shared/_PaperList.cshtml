@model PaperListModel
<div id="rs-popular-courses" class="rs-popular-courses bg6 style1 pt-94 pb-70 md-pt-64 md-pb-40" style="background-color: #f9f7f8;">
    <div class="container">
        <div class="row y-middle mb-50 md-mb-30">
            <div class="col-md-6 sm-mb-30">
                <div class="sec-title">
                    <h2 class="title mb-0">@Model.Title</h2>
                </div>
            </div>
        </div>
        <div class="row">
            @foreach (var card in Model.Cards)
            {
                @await Html.PartialAsync("_PaperCard", card)
            }
        </div>
    </div>
</div>
