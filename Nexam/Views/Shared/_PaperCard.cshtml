@model PaperCardModel
@{
    var paper = Model.Paper;
}
<a class="paper-card" href="@Model.Url" data-filter-item data-filter-group="@Model.Badge"
   data-filter-text="@paper.PaperName @paper.PaperDetail @Model.Badge @Model.Footer">
    <div class="top">
        <span class="badge">@Model.Badge</span>
        <span class="name">@paper.PaperName</span>
    </div>
    @if (!string.IsNullOrWhiteSpace(paper.PaperDetail))
    {
        <h3>@paper.PaperDetail</h3>
    }
    <div class="foot">
        <span>@Model.Footer</span>
        <span class="go" aria-hidden="true"><svg class="icon"><use href="#i-arrow-right"/></svg></span>
    </div>
</a>
