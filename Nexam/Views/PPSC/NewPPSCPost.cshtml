@{
    ViewBag.Title = "NewPPSCPost";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-head">
    <h1>Add new PPSC post</h1>
    <p>Posts group PPSC papers by the job they are for.</p>
    <div class="cluster"><a class="btn btn-secondary btn-sm" href="/PPSC/PPSC_Home">Back to PPSC</a></div>
</div>

<form class="form-card" action="/PPSC/SavePPSCPost" method="post" style="max-width:720px">
    <div class="form-grid">
        <div class="field">
            <label for="post-name">Post name</label>
            <input class="input" type="text" id="post-name" name="postname" dir="auto" placeholder="Enter post name" required>
        </div>
        <div class="field">
            <label for="post-detail">Post detail</label>
            <input class="input" type="text" id="post-detail" name="postdetail" dir="auto" placeholder="Enter one line post detail">
        </div>
    </div>
    <div class="form-actions">
        <button class="btn btn-primary" type="submit">Submit</button>
        <a class="btn btn-ghost" href="/PPSC/PPSC_Home">Cancel</a>
    </div>
</form>
