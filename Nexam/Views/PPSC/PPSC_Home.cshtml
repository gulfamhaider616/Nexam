@{
    ViewBag.Title = "PPSC_Home";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-head">
    <h1>PPSC papers</h1>
    <p>Manage PPSC past papers and their questions.</p>
</div>

<div class="admin-tiles">
    <a class="admin-tile" href="/PPSC/NewPaper">
        <span class="tile"><svg class="icon" aria-hidden="true"><use href="#i-plus"/></svg></span>
        <div><h3>Add new PPSC paper</h3><p>Create a paper with its year and post.</p></div>
    </a>
    <a class="admin-tile" href="/PPSC/NewPPSCPost">
        <span class="tile"><svg class="icon" aria-hidden="true"><use href="#i-plus"/></svg></span>
        <div><h3>Add new post</h3><p>Add a job post that papers can belong to.</p></div>
    </a>
    <a class="admin-tile" href="/PPSC/NewPPSCQuestion">
        <span class="tile"><svg class="icon" aria-hidden="true"><use href="#i-edit"/></svg></span>
        <div><h3>Add new PPSC question</h3><p>Add an MCQ to an existing paper.</p></div>
    </a>
    <a class="admin-tile" href="/PPSC/GetAllPPSCPapersByAdmin">
        <span class="tile"><svg class="icon" aria-hidden="true"><use href="#i-file-text"/></svg></span>
        <div><h3>All PPSC papers</h3><p>Browse, update and manage questions.</p></div>
    </a>
</div>
