@model NewPaperViewModel
@{
    ViewBag.Title = "NewPaper";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-head">
    <h1>Add new PPSC paper</h1>
    <p>Choose the year and post, then name the paper.</p>
    <div class="cluster"><a class="btn btn-secondary btn-sm" href="/PPSC/PPSC_Home">Back to PPSC</a></div>
</div>

<form class="form-card" action="/PPSC/SaveNewPaper" method="post" style="max-width:720px">
    <div class="form-grid cols-2">
        <div class="field">
            <label for="paper-year">Year</label>
            <select class="select" id="paper-year" name="paperyear">
                @foreach (var Item in Model.PaperYear)
                {
                    <option value="@Item.YearID">@Item.Year</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="paper-post">Post</label>
            <select class="select" id="paper-post" name="paperpost">
                @foreach (var Item in Model.PaperPost)
                {
                    <option value="@Item.PostID">@Item.Post</option>
                }
            </select>
        </div>
    </div>
    <div class="form-grid">
        <div class="field">
            <label for="paper-name">Paper name</label>
            <input class="input" type="text" id="paper-name" name="name" dir="auto" placeholder="Enter paper name" required>
        </div>
        <div class="field">
            <label for="paper-detail">Paper detail</label>
            <input class="input" type="text" id="paper-detail" name="detail" dir="auto" placeholder="Enter one line paper detail">
        </div>
    </div>
    <div class="form-actions">
        <button class="btn btn-primary" type="submit">Submit</button>
        <a class="btn btn-ghost" href="/PPSC/GetAllPPSCPapersByAdmin">Cancel</a>
    </div>
</form>
