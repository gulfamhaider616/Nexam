@model NewPaperViewModel
@{
    ViewBag.Title = "NewPaper";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="main_btm">
	<!-- start main_btm -->
	<div class="container">
		<div class="main row">
			<div class="col-md-8">
				<div class="contact-form">
					<h2>ADD New PPSC Paper</h2>
					<form action="/PPSC/SaveNewPaper" method="post" style="font-size:18px;line-height:2em;">
                        <div>
                            <span>Select Year</span>
                            <span>
                                <select class="form-control" name="paperyear" id="userName">
                                    @foreach (var Item in Model.PaperYear)
                                    {
                                        <option value="@Item.YearID">@Item.Year</option>
                                    }
                                </select>
                            </span>
                        </div>
                        <div>
                            <span>Select Post</span>
                            <span>
                                <select class="form-control" name="paperpost" id="userName">
                                    @foreach (var Item in Model.PaperPost)
                                    {
                                        <option value="@Item.PostID">@Item.Post</option>
                                    }
                                </select>
                            </span>
                        </div>
						<div>
							<span>Paper Name</span>
							<span><input type="text" name="name" class="form-control" id="userName" placeholder="Enter subject name"></span>
						</div>
						<div>
							<span>Paper Detail</span>
							<span><input type="text" name="detail" class="form-control" id="inputEmail3" placeholder="enter one line subject detail"></span>
						</div>
						<div>
							<label class="fa-btn btn-1 btn-1e"><input type="submit" value="Submit"></label>
						</div>
					</form>
				</div>
			</div>
			<div class="clearfix"></div>
		</div>
	</div>
</div>

