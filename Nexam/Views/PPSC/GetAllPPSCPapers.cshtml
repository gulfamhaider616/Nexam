@model IEnumerable<PaperDO>
@{
	ViewBag.Title = "Nexam | PPSC Past Papers";
	ViewBag.Description = "Online Nexam measures your improvement against the exam requirement and provides you with constant feedback and guidance....";
	ViewBag.KeyWords = "PPSC Past Papers,All Past Papers, NTS Past Papers,Add Question,Terms and conditions,Question,Subjects,nexam contact,Contact,Nexam,About nexam,MCQ,MCQS,CSS,NTS,PPSC,MCQ Preperation,General Knowledge,Pak study,Islamic Study,PAK AFFAIRS,MATHEMATIC,INTERNATIONAL AFFAIRS,COMPUTER SCIENCE,ENGLISH,GEOGRAPHY";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="rs-popular-courses" class="rs-popular-courses bg6 style1 pt-94 pb-70 md-pt-64 md-pb-40" style="background-color: #f9f7f8;">
    <div class="container">
        <div class="row y-middle mb-50 md-mb-30">
            <div class="col-md-6 sm-mb-30">
                <div class="sec-title">
                    @*<div class="sub-title primary">Top </div>*@
                    <h2 class="title mb-0">PPSC Past Papers</h2>
                </div>
            </div>
        </div>
        <div class="row">
            @foreach (var Item in Model)
            {
                <div class="col-lg-4 col-md-6 mb-30 wow fadeInUp" data-wow-delay="300ms" data-wow-duration="2000ms">
                    <div class="courses-item" style="box-shadow: 0px 0px 16px lightgrey;">
                        <div class="content-part">
                            <ul class="meta-part">
                            @if (Item.PaperYear != null)
                            {
                                <li><span class="price">@Item.PaperYear</span></li>
                            }
                            else
                            {
                                <li><span class="price">Recent</span></li>
                            }
                                <li><a class="categorie" href="~/PPSC-Past-Paper-Question/@Item.PaperID" style="color: #21a7d0;font-size: 21px;">@Item.PaperName</a></li>
                            </ul>
                            <h3 class="title"><a href="~/PPSC-Past-Paper-Question/@Item.PaperID">@Item.PaperDetail</a></h3>
                            <div class="bottom-part">
                                <div class="info-meta">
                                    <ul>
                                        @if (Item.PaperPost != null)
                                        {
                                            <li class="user">Post: @Item.PaperPost</li>
                                        }
                                        else
                                        {
                                            <li class="user">Post: Generic</li>
                                        }

                                    </ul>
                                </div>
                                <div class="btn-part">
                                    <a href="~/PPSC-Past-Paper-Question/@Item.PaperID"><i class="flaticon-right-arrow"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
