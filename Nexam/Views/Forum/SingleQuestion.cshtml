
@model ForumQuestion
@{
    ViewBag.Title = Model.Subject + " | Nexam Forum";
    ViewBag.Description = Model.Explanation;
    ViewBag.KeyWords = "NEXAM FORUM,ASK QUESTION ABOUT MCQS,GENERAL KNOWLEDGE MCQS FOR, NTS TEST, PPSC TEST, FPSC TEST, BPSC TEST, SPSC TEST, KPKPSC TEST, AJKPSC TEST, SOLVED MCQS ABOUT WORLD COUNTRY CAPITALS, WORLD ORGANIZATIONS, GENERAL KNOWLEDGE HELPING MATERIAL FOR JOB TEST";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="rs-inner-blog orange-color pt-100 pb-100 md-pt-70 md-pb-70" style="background-color: #f9f7f8;">
    <div class="container">
        <div class="row">

            <div class="col-lg-12 pr-10">
                <div class="row">
                    <div class="col-lg-12 mb-10">
                        <div class="blog-item">
                            <div class="blog-content">
                                <h3 class="blog-title"> <a href="#">@Model.Subject</a></h3>
                                <div class="blog-meta">
                                    <ul class="btm-cate">
                                        <li>
                                            <div class="blog-date">
                                                <i class="fa fa-calendar-check-o"></i> <span>@Model.UserName | @Model.Country</span>
                                            </div>
                                        </li>

                                    </ul>
                                </div>
                                <div class="blog-desc">
                                    @Model.Explanation
                                </div>
                        </div>
                            <hr />
                        <div id="disqus_thread" style="padding: 30px;"></div>
                        <script>

