@model IEnumerable<ForumQuestion>
@{
    ViewBag.Title = "ForumMainPage";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int count = 1;
}
@section Head {
    <link rel="stylesheet" href="/css/pages-admin.css">
}
@section Scripts {
    <script src="/js/forum-admin.js"></script>
}

<div class="page-head">
    <h1>Published questions</h1>
    <p>Questions that are visible on the public forum.</p>
    <div class="cluster">
        <a class="chip" href="/Forum/ForumMainPage">All</a>
        <a class="chip" href="/Forum/Publish" aria-pressed="true">Published</a>
        <a class="chip" href="/Forum/UnPublish">Awaiting review</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="empty mt-3">
        <svg class="icon" aria-hidden="true"><use href="#i-message"/></svg>
        <p class="mb-0">No published questions yet.</p>
    </div>
}
else
{
    <div class="mt-3" data-filter-scope>
        <div class="table-tools">
            <div class="search-field">
                <svg class="icon" aria-hidden="true"><use href="#i-search"/></svg>
                <input class="input" type="search" placeholder="Filter by title, name or country" aria-label="Filter published questions" data-filter-input>
            </div>
            <span class="count" data-filter-count></span>
        </div>
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr><th class="num">#</th><th>Title</th><th>Name</th><th>Country</th><th>Status</th><th>Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var Item in Model)
                    {
                        <tr data-filter-item>
                            <td class="num">@count</td>
                            <td><a class="cell-title" dir="auto" href="/Forum/AdminQuestionPreview?QuestionID=@Item.AskQuestionID">@Item.Subject</a></td>
                            <td>@Item.UserName</td>
                            <td>@Item.Country</td>
                            <td>
                                @if (Item.Publish == 0)
                                {
                                    <span class="badge badge-amber">Awaiting review</span>
                                }
                                else
                                {
                                    <span class="badge badge-success">Published</span>
                                }
                            </td>
                            <td>
                                <div class="actions">
                                    <a class="btn btn-secondary btn-sm" href="/Forum/AdminQuestionPreview?QuestionID=@Item.AskQuestionID"><svg class="icon" aria-hidden="true"><use href="#i-eye"/></svg>Preview</a>
                                    @if (Item.Publish == 0)
                                    {
                                        <button type="button" class="btn btn-primary btn-sm" data-action="publish" data-id="@Item.AskQuestionID">Publish</button>
                                    }
                                    <button type="button" class="btn btn-danger btn-sm" data-action="delete" data-id="@Item.AskQuestionID" data-confirm="Delete this forum question? This cannot be undone."><svg class="icon" aria-hidden="true"><use href="#i-trash"/></svg>Delete</button>
                                </div>
                            </td>
                        </tr>
                        count++;
                    }
                </tbody>
            </table>
        </div>
        <div class="empty hidden mt-3" data-filter-empty>
            <svg class="icon" aria-hidden="true"><use href="#i-search"/></svg>
            <p class="mb-0">No question matches your filter.</p>
        </div>
    </div>
}
