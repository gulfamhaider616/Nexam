@{
    ViewBag.Title = "Nexam | Ask Question";
    ViewBag.Description = "Ask your question on the Nexam forum about MCQs, past papers or exam preparation. Our team will review it and publish it very soon.";
    ViewBag.KeyWords = "Nexam forum, ask question, MCQs forum, PPSC, FPSC, NTS, exam preparation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container container-narrow">
    <div class="page-head">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/Nexam-Forum">Forum</a><span>/</span><span aria-current="page">Ask a question</span></nav>
        <h1>Please enter what you want to ask</h1>
        <p>We review every question before it is published on the forum.</p>
    </div>

    <div class="section" style="padding-top:20px">
        <form class="form-card" id="askForm" method="post" action="/Forum/SaveQuestion">
            <div class="form-grid cols-2">
                <div class="field">
                    <label for="qname">User name</label>
                    <input class="input" type="text" id="qname" name="uname" autocomplete="name" required>
                </div>
                <div class="field">
                    <label for="qemail">Email address</label>
                    <input class="input" type="email" id="qemail" name="qemail" autocomplete="email" required>
                </div>
                <div class="field">
                    <label for="qcountry">Country</label>
                    <input class="input" type="text" id="qcountry" name="qcountry" autocomplete="country-name" required>
                </div>
                <div class="field">
                    <label for="qsubject">Subject</label>
                    <input class="input" type="text" id="qsubject" name="qsubject" required>
                </div>
            </div>
            <div class="field">
                <label for="qexplanation">Question detail</label>
                <textarea class="textarea" id="qexplanation" name="qexplanation" dir="auto" required></textarea>
            </div>
            <div class="field">
                <label class="check"><input type="checkbox" name="CHKBOX1" id="CHKBOX1" value="1" required><span>You must agree with our <a href="/nexam/terms-conditions" target="_blank" rel="noopener">Terms and Conditions</a>.</span></label>
            </div>
            <div class="form-actions">
                <button type="submit" id="questionSubmit" class="btn btn-primary btn-lg">Submit question</button>
                <a class="btn btn-secondary btn-lg" href="/Nexam-Forum">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="/js/forum.js"></script>
}
