	ViewBag.KeyWords = "NTS Past Paper,All Past Papers, NTS Past Papers,Add Question,Terms and conditions,Question,Subjects,nexam contact,Contact,Nexam,About nexam,MCQ,MCQS,CSS,NTS,PPSC,MCQ Preperation,General Knowledge,Pak study,Islamic Study,PAK AFFAIRS,MATHEMATIC,INTERNATIONAL AFFAIRS,COMPUTER SCIENCE,ENGLISH,GEOGRAPHY";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

@await Html.PartialAsync("_PaperList", new PaperListModel("NTS Past Papers",
    Model.Select(p => new PaperCardModel(p, Url.Content("~/NTS-Past-Paper-Question/" + p.PaperID), "NTS", "Exam: NTS"))))
