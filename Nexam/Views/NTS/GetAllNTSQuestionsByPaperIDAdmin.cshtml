@model QuestionListViewModel
@{
    ViewBag.Title = "Nexam | NTS Question";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var questions = Model.questions ?? new List<Question>();
    var paperList = Model.PaperList ?? new List<Paper>();
    var paperName = string.IsNullOrWhiteSpace(Model.Paper) ? "NTS paper" : Model.Paper;
}

<div class="page-head">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/NTS/NTS_Home">NTS</a><span>/</span><a href="/NTS/GetAllNTSPapersByAdmin">Papers</a><span>/</span><span aria-current="page" dir="auto">@paperName</span></nav>
    <h1 dir="auto">@paperName</h1>
    <p>@questions.Count @(questions.Count == 1 ? "question" : "questions") in this paper.</p>
    <div class="cluster">
        <a class="btn btn-primary" href="/NTS/NewNTSQuestion"><svg class="icon" aria-hidden="true"><use href="#i-plus"/></svg>Add question</a>
        <a class="btn btn-secondary" href="/NTS/GetAllNTSPapersByAdmin">All papers</a>
        @if (Model.PaperID != 0)
        {
            <a class="btn btn-ghost" href="/NTS-Past-Paper-Question/@Model.PaperID" target="_blank" rel="noopener"><svg class="icon" aria-hidden="true"><use href="#i-external"/></svg>View on site</a>
        }
    </div>
</div>

@if (paperList.Count > 0)
{
    <details class="panel" style="margin-bottom:16px">
        <summary style="cursor:pointer;font-weight:600">Switch to another paper</summary>
        <div class="stack" style="--gap:4px;margin-top:12px;max-height:260px;overflow-y:auto">
            @foreach (var item in paperList)
            {
                <a href="/NTS/GetAllNTSQuestionsByPaperIDAdmin?paperid=@item.PaperID" dir="auto" style="display:block;padding:4px 0">@item.PaperName</a>
            }
        </div>
    </details>
}

<div data-filter-scope>
    <div class="filters">
        <div class="search-field">
            <svg class="icon" aria-hidden="true"><use href="#i-search"/></svg>
            <input class="input" type="search" placeholder="Filter these questions" aria-label="Filter these questions" data-filter-input>
        </div>
        <div class="filter-meta"><span data-filter-count></span></div>
    </div>

    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr><th>#</th><th>Question</th><th>Answer</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @for (var i = 0; i < questions.Count; i++)
                {
                    var item = questions[i];
                    <tr data-filter-item>
                        <td>@(i + 1)</td>
                        <td>
                            <strong dir="auto">@item.QuestionStatement</strong>
                            @if (item.Options != null && item.Options.Count > 0)
                            {
                                <ol type="A" dir="auto" style="margin:8px 0 0;padding-left:1.4em">
                                    @foreach (var option in item.Options)
                                    {
                                        <li>@option.Choice</li>
                                    }
                                </ol>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.CorrectAnswer))
                            {
                                <span class="badge badge-success" dir="auto">@item.CorrectAnswer</span>
                            }
                        </td>
                        <td>
                            <div class="actions">
                                <a class="btn btn-secondary btn-sm btn-icon" href="/NTS/GetNTSQuestionById?questionID=@item.QuestionID" title="Edit" aria-label="Edit"><svg class="icon" aria-hidden="true"><use href="#i-edit"/></svg><span class="sr-only">Edit</span></a>
                                <a class="btn btn-danger btn-sm btn-icon" href="/NTS/DeleteNTSQuestionById?questionID=@item.QuestionID" data-confirm="Delete this question? This cannot be undone." title="Delete" aria-label="Delete"><svg class="icon" aria-hidden="true"><use href="#i-trash"/></svg><span class="sr-only">Delete</span></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="empty @(questions.Count == 0 ? "" : "hidden")" data-filter-empty>
        <svg class="icon" aria-hidden="true"><use href="#i-search"/></svg>
        <p class="mb-0">No questions found.</p>
    </div>
</div>
