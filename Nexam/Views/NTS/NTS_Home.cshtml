@{
    ViewBag.Title = "NTS_Home";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-head">
    <h1>NTS papers</h1>
    <p>Manage NTS past papers and their questions.</p>
</div>

<div class="admin-tiles">
    <a class="admin-tile" href="/NTS/NewNTSPaper">
        <span class="tile"><svg class="icon" aria-hidden="true"><use href="#i-plus"/></svg></span>
        <div><h3>Add new NTS paper</h3><p>Create a new NTS paper.</p></div>
    </a>
    <a class="admin-tile" href="/NTS/NewNTSQuestion">
        <span class="tile"><svg class="icon" aria-hidden="true"><use href="#i-edit"/></svg></span>
        <div><h3>Add new NTS question</h3><p>Add an MCQ to an existing paper.</p></div>
    </a>
    <a class="admin-tile" href="/NTS/GetAllNTSPapersByAdmin">
        <span class="tile"><svg class="icon" aria-hidden="true"><use href="#i-file-text"/></svg></span>
        <div><h3>All NTS papers</h3><p>Browse papers and manage questions.</p></div>
    </a>
</div>
