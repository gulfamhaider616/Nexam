@model IEnumerable<Paper>
@{
    ViewBag.Title = "Nexam | NTS Paper";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var papers = Model?.ToList() ?? new List<Paper>();
}

<div class="page-head">
    <h1>NTS papers</h1>
    <p>All NTS papers. Open one to manage its questions.</p>
    <div class="cluster">
        <a class="btn btn-primary" href="/NTS/NewNTSPaper"><svg class="icon" aria-hidden="true"><use href="#i-plus"/></svg>Add paper</a>
        <a class="btn btn-secondary" href="/NTS/NewNTSQuestion">Add question</a>
    </div>
</div>

<div data-filter-scope>
    <div class="filters">
        <div class="search-field">
            <svg class="icon" aria-hidden="true"><use href="#i-search"/></svg>
            <input class="input" type="search" placeholder="Filter papers by name or detail" aria-label="Filter papers" data-filter-input>
        </div>
        <div class="filter-meta"><span data-filter-count></span></div>
    </div>

    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr><th>Paper</th><th>Detail</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var Item in papers)
                {
                    <tr data-filter-item>
                        <td><strong dir="auto">@Item.PaperName</strong></td>
                        <td dir="auto">@Item.PaperDetail</td>
                        <td>
                            <div class="actions">
                                <a class="btn btn-secondary btn-sm" href="/NTS/GetAllNTSQuestionsByPaperIDAdmin?paperid=@Item.PaperID">Questions</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="empty @(papers.Count == 0 ? "" : "hidden")" data-filter-empty>
        <svg class="icon" aria-hidden="true"><use href="#i-file-text"/></svg>
        <p class="mb-0">No papers found.</p>
    </div>
</div>
