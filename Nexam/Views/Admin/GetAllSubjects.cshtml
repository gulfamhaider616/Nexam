@model SubjectsPageViewModel
@{
    ViewBag.Title = "Nexam | Subject";
    ViewBag.Description = "Online Nexam measures your improvement against the exam requirement and provides you with constant feedback and guidance....";
    ViewBag.KeyWords = "Add Question,Terms and conditions,Question,Subjects,nexam contact,Contact,Nexam,About nexam,MCQ,MCQS,CSS,NTS,PPSC,MCQ Preperation,General Knowledge,Pak study,Islamic Study,PAK AFFAIRS,MATHEMATIC,INTERNATIONAL AFFAIRS,COMPUTER SCIENCE,ENGLISH,GEOGRAPHY";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@section Head {
    <link rel="stylesheet" href="/css/pages-admin.css" asp-append-version="true">
}

<div class="page-head">
    <h1>Subjects</h1>
    <p>Open a subject to review, edit or delete its questions.</p>
    <div class="cluster">
        <a class="btn btn-primary" href="/Admin/AddNewQuestion"><svg class="icon" aria-hidden="true"><use href="#i-plus"/></svg>Add question</a>
        <a class="btn btn-secondary" href="/Admin/AddNewSubject"><svg class="icon" aria-hidden="true"><use href="#i-plus"/></svg>Add subject</a>
    </div>
</div>

@{
    string PageUrl(int page)
    {
        var parts = new List<string> { "country=" + Uri.EscapeDataString(Model.Country ?? "") };
        if (!string.IsNullOrWhiteSpace(Model.Text)) parts.Add("q=" + Uri.EscapeDataString(Model.Text));
        if (page > 1) parts.Add("page=" + page);
        return "/Admin/GetAllSubjects?" + string.Join("&", parts);
    }
}
<div class="stat-grid mt-3">
    <div class="stat"><strong>@Model.TotalSubjects</strong><span>Subjects in total</span></div>
    <div class="stat"><strong>@Model.Total</strong><span>Matching this filter</span></div>
</div>

<form class="table-tools" action="/Admin/GetAllSubjects" method="get" role="search" data-live-search>
    <div class="search-field">
        <svg class="icon" aria-hidden="true"><use href="#i-search"/></svg>
        <input class="input" type="search" name="q" value="@Model.Text" placeholder="Search subjects" aria-label="Search subjects" autocomplete="off">
    </div>
    <select class="select" name="country" aria-label="Country" style="max-width:260px">
        <option value="" selected="@string.IsNullOrEmpty(Model.Country)">All countries</option>
        @foreach (var c in Model.Countries)
        {
            <option value="@c.Country" selected="@(string.Equals(Model.Country, c.Country, StringComparison.OrdinalIgnoreCase))">@SubjectGroups.Label(c.Country) (@c.Count)</option>
        }
    </select>
</form>

<div data-live-results aria-live="polite">
    <div class="admin-tiles">
        @foreach (var Item in Model.Items)
        {
            <a class="admin-tile" href="/Admin/GetAllQuestionsByAdmin?SubjectID=@Item.SubjectID">
                <span class="tile"><svg class="icon" aria-hidden="true"><use href="#i-layers"/></svg></span>
                <div>
                    <h3>@Item.SubjectName</h3>
                    <p>@Item.SubjectDetail</p>
                </div>
            </a>
        }
    </div>
    @if (Model.Total == 0)
    {
        <div class="empty">
            <svg class="icon" aria-hidden="true"><use href="#i-layers"/></svg>
            <p class="mb-0">No subject matches your filter.</p>
        </div>
    }
    @if (Model.Pages > 1)
    {
        <nav class="pager" aria-label="Pages">
            @if (Model.Page > 1) { <a class="btn btn-secondary btn-sm" href="@PageUrl(Model.Page - 1)">&larr; Previous</a> }
            <span class="muted">Page @Model.Page of @Model.Pages</span>
            @if (Model.Page < Model.Pages) { <a class="btn btn-secondary btn-sm" href="@PageUrl(Model.Page + 1)">Next &rarr;</a> }
        </nav>
    }
</div>
