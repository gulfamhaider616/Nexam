
@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="main_btm">
    <!-- start main_btm -->
    <div class="container">
        <div class="main row">
            <div class="col-md-8">
                <div class="contact-form">
                    <h2>Admin Pannel</h2>
                    <form action="/Admin/VerifyAdmin" method="post" style="font-size:18px;line-height:2em;">
                        <div>
                            <span>Email</span>
                            <span><input type="email" name="adminname" class="form-control" id="userName" placeholder="Admin Email"></span>
                        </div>
                        <div>
                            <span>Password</span>
                            <span><input type="password" name="adminpassword" class="form-control" id="inputEmail3" placeholder="Admin Password"></span>
                        </div>
                        <div>
                            <label class="fa-btn btn-1 btn-1e"><input type="submit" value="Submit"></label>
                        </div>
                    </form>
                </div>
            </div>
            <div class="clearfix"></div>
        </div>
    </div>
</div>


