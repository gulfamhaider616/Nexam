@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container auth-wrap">
    <div class="auth-card form-card">
        <h1>Admin panel</h1>
        <p class="muted">Sign in with your administrator account to manage subjects, questions and papers.</p>
        <form action="/Admin/VerifyAdmin" method="post">
            <div class="field">
                <label for="adminname">Email</label>
                <input class="input" type="email" name="adminname" id="adminname" placeholder="Admin email" autocomplete="username" required>
            </div>
            <div class="field">
                <label for="adminpassword">Password</label>
                <input class="input" type="password" name="adminpassword" id="adminpassword" placeholder="Admin password" autocomplete="current-password" required>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-block">Sign in</button>
            </div>
        </form>
    </div>
</div>
