@model QuestionListViewModel
@{
    ViewBag.Title = "Nexam | Question";
    ViewBag.Description = "Online Nexam measures your improvement against the exam requirement and provides you with constant feedback and guidance....";
    ViewBag.KeyWords = "Add Question,Terms and conditions,Question,Subjects,nexam contact,Contact,Nexam,About nexam,MCQ,MCQS,CSS,NTS,PPSC,MCQ Preperation,General Knowledge,Pak study,Islamic Study,PAK AFFAIRS,MATHEMATIC,INTERNATIONAL AFFAIRS,COMPUTER SCIENCE,ENGLISH,GEOGRAPHY";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int counter = 1;
}
@section Head {
    <link rel="stylesheet" href="/css/pages-admin.css">
}

<div class="page-head">
    <h1>@(string.IsNullOrWhiteSpace(Model.Subject) ? "Questions" : Model.Subject)</h1>
    <p>Edit or delete questions in this subject.</p>
    <div class="cluster">
        <a class="btn btn-primary" href="/Admin/AddNewQuestion"><svg class="icon" aria-hidden="true"><use href="#i-plus"/></svg>Add question</a>
        <a class="btn btn-secondary" href="/Admin/GetAllSubjects">All subjects</a>
    </div>
</div>

@if (Model.SubjectList != null && Model.SubjectList.Count > 0)
{
    <nav class="chips subject-chips mt-3" aria-label="Subjects">
        @foreach (var item in Model.SubjectList)
        {
            <a class="chip" href="/Admin/GetAllQuestionsByAdmin?SubjectID=@item.SubjectID" aria-pressed="@(item.SubjectName == Model.Subject ? "true" : null)">@item.SubjectName</a>
        }
    </nav>
}

@if (Model.questions == null || Model.questions.Count == 0)
{
    <div class="empty">
        <svg class="icon" aria-hidden="true"><use href="#i-quiz"/></svg>
        <p class="mb-0">There are no questions in this subject yet.</p>
    </div>
}
else
{
    <div data-filter-scope>
        <div class="table-tools">
            <div class="search-field">
                <svg class="icon" aria-hidden="true"><use href="#i-search"/></svg>
                <input class="input" type="search" placeholder="Filter these questions" aria-label="Filter these questions" data-filter-input>
            </div>
            <span class="count" data-filter-count></span>
        </div>

        <div class="table-wrap">
            <table class="table qa-list">
                <thead>
                    <tr><th class="num">#</th><th>Question</th><th>Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.questions)
                    {
                        <tr data-filter-item>
                            <td class="num">@counter</td>
                            <td>
                                <a class="qa-text" dir="auto" href="/Question-Detail/@item.QuestionID">@item.QuestionStatement</a>
                                @if (item.Options != null && item.Options.Count > 0)
                                {
                                    int letter = 0;
                                    <ul class="qa-opts" dir="auto">
                                        @foreach (var option in item.Options)
                                        {
                                            var isCorrect = !string.IsNullOrWhiteSpace(item.CorrectAnswer) && string.Equals((option.Choice ?? "").Trim(), item.CorrectAnswer.Trim(), StringComparison.OrdinalIgnoreCase);
                                            <li class="@(isCorrect ? "is-correct" : null)"><span class="l">@((char)('A' + letter++))</span>@option.Choice</li>
                                        }
                                    </ul>
                                }
                                @if (!string.IsNullOrEmpty(item.CorrectAnswer))
                                {
                                    <p class="qa-answer" dir="auto">Correct answer: @item.CorrectAnswer</p>
                                }
                            </td>
                            <td>
                                <div class="actions">
                                    <a class="btn btn-secondary btn-sm" href="/Admin/GetQuestionById?questionID=@item.QuestionID"><svg class="icon" aria-hidden="true"><use href="#i-edit"/></svg>Edit</a>
                                    <a class="btn btn-danger btn-sm" href="/Admin/DeleteQuestion?questionID=@item.QuestionID" data-confirm="Delete this question? This cannot be undone."><svg class="icon" aria-hidden="true"><use href="#i-trash"/></svg>Delete</a>
                                </div>
                            </td>
                        </tr>
                        counter++;
                    }
                </tbody>
            </table>
        </div>
        <div class="empty hidden mt-3" data-filter-empty>
            <svg class="icon" aria-hidden="true"><use href="#i-search"/></svg>
            <p class="mb-0">No question matches your filter.</p>
        </div>
    </div>
}
