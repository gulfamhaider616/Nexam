@model IEnumerable<Subject>
@{
    ViewBag.Title = "Nexam | Add Question";
    ViewBag.Description = "Online Nexam measures your improvement against the exam requirement and provides you with constant feedback and guidance....";
    ViewBag.KeyWords = "Add Question,Terms and conditions,Question,Subjects,nexam contact,Contact,Nexam,About nexam,MCQ,MCQS,CSS,NTS,PPSC,MCQ Preperation,General Knowledge,Pak study,Islamic Study,PAK AFFAIRS,MATHEMATIC,INTERNATIONAL AFFAIRS,COMPUTER SCIENCE,ENGLISH,GEOGRAPHY";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@section Head {
    <link rel="stylesheet" href="/css/pages-admin.css" asp-append-version="true">
}

<div class="page-head">
    <h1>Add question</h1>
    <p>Add a multiple-choice question to a subject.</p>
</div>

<div class="form-card wide mt-3">
    <form action="/Admin/SaveQuestion" method="post">
        <div class="form-grid cols-2">
            <div class="field">
                <label for="subjectid">Subject</label>
                <select class="select" name="subjectid" id="subjectid">
                    @foreach (var Item in Model)
                    {
                        <option value="@Item.SubjectID">@Item.SubjectName</option>
                    }
                </select>
            </div>
            <div class="field">
                <label for="numberofchoices">Total choices</label>
                <select class="select" name="numberofchoices" id="numberofchoices">
                    @for (int n = 0; n <= 10; n++)
                    {
                        <option value="@n" selected="@(n == 4)">@n</option>
                    }
                </select>
                <span class="help">Use 0 for a question without choices.</span>
            </div>
        </div>
        <div class="field">
            <label for="questionstatement">Question statement</label>
            <input class="input" type="text" name="questionstatement" id="questionstatement" dir="auto" placeholder="For inline only add question statement" required>
        </div>
        <div class="field">
            <label for="choices">Choices</label>
            <input class="input" type="text" name="choices" id="choices" dir="auto" placeholder="Choice one, choice two, choice three, choice four">
            <span class="help">Enter the choices separated by commas.</span>
        </div>
        <div class="field">
            <label for="correctanswer">Correct answer</label>
            <input class="input" type="text" name="correctanswer" id="correctanswer" dir="auto" placeholder="Enter the correct answer">
            <span class="help">Type it exactly as it appears in the choices.</span>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save question</button>
            <a class="btn btn-secondary" href="/Admin/GetAllSubjects">Cancel</a>
        </div>
    </form>
</div>
