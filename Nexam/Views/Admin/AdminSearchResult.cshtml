@model QuestionListViewModel
@{
    ViewBag.Title = "Nexam | Admin Search";
    ViewBag.Description = "Online Nexam measures your improvement against the exam requirement and provides you with constant feedback and guidance....";
    ViewBag.KeyWords = "Admin Search,Add Question,Terms and conditions,Question,Subjects,nexam contact,Contact,Nexam,About nexam,MCQ,MCQS,CSS,NTS,PPSC,MCQ Preperation,General Knowledge,Pak study,Islamic Study,PAK AFFAIRS,MATHEMATIC,INTERNATIONAL AFFAIRS,COMPUTER SCIENCE,ENGLISH,GEOGRAPHY";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int counter = 1;
    bool hasSearch = !string.IsNullOrWhiteSpace(Model.Search);
    string summary = (Model.TotalCount > 1000 ? "1000+" : Model.TotalCount.ToString()) + (Model.TotalCount == 1 ? " matching question" : " matching questions");
    if (Model.questions != null && Model.questions.Count < Model.TotalCount) { summary += ", showing the first " + Model.questions.Count; }
}
@section Head {
    <link rel="stylesheet" href="/css/pages-admin.css" asp-append-version="true">
}

<div class="page-head">
    <h1>Search questions</h1>
    <p>Search every subject by question text. Results update as you type.</p>
    <form class="cluster mt-2" action="/Admin/AdminSearchResult" method="get" role="search" data-live-search>
        <div class="search-field" style="position:relative;flex:1 1 280px;max-width:480px">
            <svg class="icon" aria-hidden="true" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--muted)"><use href="#i-search"/></svg>
            <input class="input" style="padding-left:40px" type="search" name="search" value="@Model.Search" placeholder="Search questions" aria-label="Search questions">
        </div>
    </form>
</div>

@if (Model.SubjectList != null && Model.SubjectList.Count > 0)
{
    <nav class="chips subject-chips mt-3" aria-label="Subjects">
        @foreach (var item in Model.SubjectList.Where(x => SubjectGroups.Of(x.SubjectName) == SubjectGroups.General))
        {
            <a class="chip" href="/Admin/GetAllQuestionsByAdmin?SubjectID=@item.SubjectID">@item.SubjectName</a>
        }
        <a class="chip" href="/Admin/GetAllSubjects">All subjects</a>
    </nav>
}

<div data-live-results aria-live="polite">
@if (hasSearch)
{
    <p class="muted mt-3">@summary for &ldquo;@Model.Search&rdquo;.</p>
}
@if (Model.questions == null || Model.questions.Count == 0)
{
    <div class="empty">
        <svg class="icon" aria-hidden="true"><use href="#i-search"/></svg>
        <p class="mb-0">@(hasSearch ? "No question matches your search." : "Type something above to search questions.")</p>
    </div>
}
else
{
    <div data-filter-scope>
        <div class="table-tools">
            <div class="search-field">
                <svg class="icon" aria-hidden="true"><use href="#i-filter"/></svg>
                <input class="input" type="search" placeholder="Filter these results" aria-label="Filter these results" data-filter-input>
            </div>
            <span class="count" data-filter-count></span>
        </div>

        <div class="table-wrap">
            <table class="table qa-list">
                <thead>
                    <tr><th class="num">#</th><th>Question</th><th>Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.questions)
                    {
                        <tr data-filter-item>
                            <td class="num">@counter</td>
                            <td>
                                <a class="qa-text" dir="auto" href="/Question-Detail/@item.QuestionID">@item.QuestionStatement</a>
                                @if (!string.IsNullOrEmpty(item.SubjectName))
                                {
                                    <span class="badge badge-muted" style="margin-left:6px">@item.SubjectName</span>
                                }
                                @if (item.Options != null && item.Options.Count > 0)
                                {
                                    int letter = 0;
                                    <ul class="qa-opts" dir="auto">
                                        @foreach (var option in item.Options)
                                        {
                                            var isCorrect = !string.IsNullOrWhiteSpace(item.CorrectAnswer) && string.Equals((option.Choice ?? "").Trim(), item.CorrectAnswer.Trim(), StringComparison.OrdinalIgnoreCase);
                                            <li class="@(isCorrect ? "is-correct" : null)"><span class="l">@((char)('A' + letter++))</span>@option.Choice</li>
                                        }
                                    </ul>
                                }
                                @if (!string.IsNullOrEmpty(item.CorrectAnswer))
                                {
                                    <p class="qa-answer" dir="auto">Correct answer: @item.CorrectAnswer</p>
                                }
                            </td>
                            <td>
                                <div class="actions">
                                    <a class="btn btn-secondary btn-sm btn-icon" href="/Admin/GetQuestionById?questionID=@item.QuestionID" title="Edit" aria-label="Edit"><svg class="icon" aria-hidden="true"><use href="#i-edit"/></svg><span class="sr-only">Edit</span></a>
                                    <a class="btn btn-danger btn-sm btn-icon" href="/Admin/DeleteQuestion?questionID=@item.QuestionID" data-confirm="Delete this question? This cannot be undone." title="Delete" aria-label="Delete"><svg class="icon" aria-hidden="true"><use href="#i-trash"/></svg><span class="sr-only">Delete</span></a>
                                </div>
                            </td>
                        </tr>
                        counter++;
                    }
                </tbody>
            </table>
        </div>
        <div class="empty hidden mt-3" data-filter-empty>
            <svg class="icon" aria-hidden="true"><use href="#i-search"/></svg>
            <p class="mb-0">No result matches your filter.</p>
        </div>
    </div>
}
</div>
