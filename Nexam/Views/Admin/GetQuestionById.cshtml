@model Question
@{
    ViewBag.Title = "Nexam | Questions";
    ViewBag.Description = "Online Nexam measures your improvement against the exam requirement and provides you with constant feedback and guidance....";
    ViewBag.KeyWords = "Add Question,Terms and conditions,Question,Subjects,nexam contact,Contact,Nexam,About nexam,MCQ,MCQS,CSS,NTS,PPSC,MCQ Preperation,General Knowledge,Pak study,Islamic Study,PAK AFFAIRS,MATHEMATIC,INTERNATIONAL AFFAIRS,COMPUTER SCIENCE,ENGLISH,GEOGRAPHY";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@section Head {
    <link rel="stylesheet" href="/css/pages-admin.css">
}

<div class="page-head">
    <h1>Edit question</h1>
    <p>Question #@Model.QuestionID in <strong>@Model.SubjectName</strong>.</p>
    <div class="cluster">
        <a class="btn btn-secondary btn-sm" href="/Admin/GetAllQuestionsByAdmin?SubjectID=@Model.SubjectID">Back to @Model.SubjectName</a>
    </div>
</div>

<div class="form-card wide mt-3">
    <form action="/Admin/SaveEditQuestion" method="post">
        <input type="hidden" name="questionid" value="@Model.QuestionID">
        <div class="form-grid cols-2">
            <div class="field">
                <label for="subjectid">Subject</label>
                <select class="select" name="subjectid" id="subjectid">
                    <option value="@Model.SubjectID">@Model.SubjectName</option>
                </select>
            </div>
            <div class="field">
                <label for="numberofchoices">Total choices</label>
                <input class="input" type="text" inputmode="numeric" value="@Model.NumberOfChoices" name="numberofchoices" id="numberofchoices">
            </div>
        </div>
        <div class="field">
            <label for="questionstatement">Question statement</label>
            <input class="input" type="text" value="@Model.QuestionStatement" name="questionstatement" id="questionstatement" dir="auto">
        </div>
        <div class="field">
            <label for="choices">Choices</label>
            <input class="input" type="text" value="@Model.Choices" name="choices" id="choices" dir="auto">
            <span class="help">Choices separated by commas.</span>
        </div>
        <div class="field">
            <label for="correctanswer">Correct answer</label>
            <input class="input" type="text" value="@Model.CorrectAnswer" name="correctanswer" id="correctanswer" dir="auto">
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a class="btn btn-secondary" href="/Admin/GetAllQuestionsByAdmin?SubjectID=@Model.SubjectID">Cancel</a>
        </div>
    </form>
</div>
