@{
    ViewBag.Title = "Nexam | Add Subject";
    ViewBag.Description = "Online Nexam measures your improvement against the exam requirement and provides you with constant feedback and guidance....";
    ViewBag.KeyWords = "Add Subjects,Add Question,Terms and conditions,Question,Subjects,nexam contact,Contact,Nexam,About nexam,MCQ,MCQS,CSS,NTS,PPSC,MCQ Preperation,General Knowledge,Pak study,Islamic Study,PAK AFFAIRS,MATHEMATIC,INTERNATIONAL AFFAIRS,COMPUTER SCIENCE,ENGLISH,GEOGRAPHY";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@section Head {
    <link rel="stylesheet" href="/css/pages-admin.css">
}

<div class="page-head">
    <h1>Add subject</h1>
    <p>Create a new subject that questions can be filed under.</p>
</div>

<div class="form-card wide mt-3">
    <form action="/Admin/SaveSubject" method="post">
        <div class="field">
            <label for="subjectname">Subject name</label>
            <input class="input" type="text" name="subjectname" id="subjectname" placeholder="Enter subject name" required>
        </div>
        <div class="field">
            <label for="subjectdetail">Subject detail</label>
            <input class="input" type="text" name="subjectdetail" id="subjectdetail" placeholder="Enter one line subject detail">
            <span class="help">Shown under the subject name on the public site.</span>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save subject</button>
            <a class="btn btn-secondary" href="/Admin/GetAllSubjects">Cancel</a>
        </div>
    </form>
</div>
