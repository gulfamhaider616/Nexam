@{
    ViewBag.Title = "Nexam | Write a Blog";
    ViewBag.Description = "Write a blog post for Nexam. Blogging is coming soon.";
    ViewBag.KeyWords = "Nexam blog, write blog";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container container-narrow">
    <div class="page-head">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/Blog/ShowAllBlogs">Blog</a><span>/</span><span aria-current="page">Write</span></nav>
        <h1>Welcome, please write here</h1>
    </div>

    <div class="section" style="padding-top:20px">
        <div class="alert" style="margin-bottom:20px">Blogging is coming soon. Posts you submit now are not published yet.</div>
        <form class="form-card" method="post" action="/Blog/SaveBlog">
            <input type="hidden" name="blogid" value="0">
            <div class="form-grid cols-2">
                <div class="field">
                    <label for="uname">Your name</label>
                    <input class="input" type="text" id="uname" name="uname" autocomplete="name">
                </div>
                <div class="field">
                    <label for="email">Email address</label>
                    <input class="input" type="email" id="email" name="email" autocomplete="email">
                </div>
                <div class="field">
                    <label for="country">Country</label>
                    <input class="input" type="text" id="country" name="country" autocomplete="country-name" required>
                </div>
                <div class="field">
                    <label for="title">Title</label>
                    <input class="input" type="text" id="title" name="title" required>
                </div>
            </div>
            <div class="field">
                <label for="desp">Your post</label>
                <textarea class="textarea" id="desp" name="desp" rows="10" dir="auto" placeholder="Please write here" required></textarea>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-lg">Submit</button>
                <a class="btn btn-secondary btn-lg" href="/Blog/ShowAllBlogs">Cancel</a>
            </div>
        </form>
    </div>
</div>
