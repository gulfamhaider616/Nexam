@{
    ViewBag.Title = "Nexam | Log in";
    ViewBag.Description = "Log in to your Nexam account.";
    ViewBag.KeyWords = "Nexam login";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string error = ViewBag.Error as string;
}

<div class="container auth-wrap">
    <div class="auth-card form-card">
        <h1>Log in</h1>
        <p class="muted">Welcome back. Log in to take quizzes, track your progress or manage the site.</p>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }

        <form action="/Login" method="post">
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl">
            <div class="field">
                <label for="email">Email</label>
                <input class="input" type="email" id="email" name="email" value="@ViewBag.Email" placeholder="you@example.com" autocomplete="username" required autofocus>
            </div>
            <div class="field">
                <label for="password">Password</label>
                <input class="input" type="password" id="password" name="password" placeholder="Your password" autocomplete="current-password" required>
            </div>
            <button type="submit" class="btn btn-primary btn-lg btn-block">Log in</button>
        </form>
        <p class="muted text-center mt-3 mb-0">Not registered? <a href="/User/User_Registration">Create an account</a></p>
    </div>
</div>
