@model QuestionListViewModel
@{
    var subjectName = string.IsNullOrWhiteSpace(Model.Subject) ? "Questions" : Model.Subject;
    ViewBag.Title = $"Nexam | {subjectName} MCQs";
    ViewBag.Description = $"Practice {subjectName} MCQs with answers: past-paper questions from PPSC, FPSC and NTS, newest first.";
    ViewBag.KeyWords = $"{subjectName}, MCQs, PPSC, FPSC, NTS, CSS, past papers";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var number = 1;
}

<div class="container">
    <div class="page-head">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/nexam/all-subjects">Subjects</a><span>/</span><span aria-current="page">@subjectName</span></nav>
        <h1>@subjectName</h1>
        <p>@Model.questions.Count questions, newest papers first. Select a question to open its discussion.</p>
    </div>

    <div class="section layout-sidebar" style="padding-top:20px">
        <div data-filter-scope>
            <div class="filters">
                <div class="search-field">
                    <svg class="icon" aria-hidden="true"><use href="#i-search"/></svg>
                    <input class="input" type="search" placeholder="Filter these questions" aria-label="Filter these questions" data-filter-input>
                </div>
                <div class="filter-meta">
                    <span data-filter-count></span>
                    <label class="switch"><input type="checkbox" data-answers-toggle><span>Show answers</span></label>
                </div>
            </div>

            <div class="q-list">
                @foreach (var question in Model.questions)
                {
                    var url = question.PaperID == 0
                        ? "/Question-Detail/" + question.QuestionID
                        : "/PPSC-Past-Paper-Question-Discussion/" + question.QuestionID;
                    @await Html.PartialAsync("_QuestionCard", new QuestionCardModel(question, number++, url, ShowSubject: false))
                }
            </div>

            <div class="empty @(Model.questions.Count == 0 ? "" : "hidden")" data-filter-empty>
                <svg class="icon" aria-hidden="true"><use href="#i-search"/></svg>
                <p class="mb-0">No questions found.</p>
            </div>
        </div>

        <aside class="sticky stack" style="--gap:16px">
            <form class="panel" action="/Home/SearchResult" method="get" role="search" data-suggest="/Home/SearchSuggest">
                <h3>Search all questions</h3>
                <div class="field mb-0"><input class="input" type="search" name="search" placeholder="Search…" aria-label="Search questions"></div>
            </form>
            <div class="panel">
                <h3>All subjects</h3>
                <div class="stack" style="--gap:6px">
                    @foreach (var s in Model.SubjectList)
                    {
                        <a href="/Questions/@s.SubjectID" style="display:block;padding:6px 0;@(s.SubjectName == Model.Subject ? "font-weight:700" : "")">@s.SubjectName</a>
                    }
                </div>
            </div>
        </aside>
    </div>
</div>
