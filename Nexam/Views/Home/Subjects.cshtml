@model IEnumerable<Subject>
@{
    ViewBag.Title = "Nexam | All Subjects";
    ViewBag.Description = "Nexam is the largest exams preperation platform. Online Nexam measures your improvement against the exam requirement and provides you with constant feedback and guidance....";
    ViewBag.KeyWords = "All Sbjects,Question,Subjects,nexam contact,Contact,Nexam,About nexam,MCQ,MCQS,CSS,NTS,PPSC,MCQ Preperation,General Knowledge,Pak study,Islamic Study,PAK AFFAIRS,MATHEMATIC,INTERNATIONAL AFFAIRS,COMPUTER SCIENCE,ENGLISH,GEOGRAPHY";
}

<div id="rs-categories" class="rs-categories gray-bg style1 pt-94 pb-70 md-pt-64 md-pb-40" style="background-color: #f9f7f8;">
    <div class="container">
        <div class="row y-middle mb-50 md-mb-30">
            <div class="col-md-6 sm-mb-30">
                <div class="sec-title">
                    <h2 class="title mb-0">All Subjects </h2>
                </div>
            </div>

        </div>
        <div class="row">
            @foreach (var Item in Model)
            {
                @await Html.PartialAsync("_SubjectCard", Item)
            }
        </div>
    </div>
</div>
