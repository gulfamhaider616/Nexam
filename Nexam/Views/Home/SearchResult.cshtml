@model QuestionListViewModel
@{
    var hasSearch = !string.IsNullOrWhiteSpace(Model.Search);
    ViewBag.Title = hasSearch ? $"Nexam | Search: {Model.Search}" : "Nexam | Search questions";
    ViewBag.Description = "Search thousands of solved MCQs across PPSC, FPSC and NTS past papers and subject banks.";
    ViewBag.KeyWords = "search MCQs, PPSC questions, past paper questions";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var number = 1;
}

<div class="container">
    <div class="page-head">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span aria-current="page">Search</span></nav>
        <h1>Search questions</h1>
    </div>

    <div class="section" style="padding-top:12px">
        <form class="filters" action="/Home/SearchResult" method="get" role="search" data-live-search>
            <div class="search-field">
                <svg class="icon" aria-hidden="true"><use href="#i-search"/></svg>
                <input class="input" type="search" name="search" value="@Model.Search" placeholder="Search any question, e.g. largest ocean" aria-label="Search questions" data-search-input autofocus>
            </div>
            <div class="cluster">
                <select class="select" name="subject" aria-label="Subject" style="max-width:260px">
                    <option value="">All subjects</option>
                    @foreach (var s in Model.SubjectList)
                    {
                        <option value="@s.SubjectID" selected="@(Model.SelectedSubjectId == s.SubjectID)">@s.SubjectName</option>
                    }
                </select>
                <noscript><button class="btn btn-primary" type="submit">Search</button></noscript>
                <label class="switch"><input type="checkbox" data-answers-toggle><span>Show answers</span></label>
            </div>
        </form>

        <div data-live-results aria-live="polite">
        @if (!hasSearch)
        {
            <div class="empty">
                <svg class="icon" aria-hidden="true"><use href="#i-search"/></svg>
                <p class="mb-0">Type a word or phrase to search all questions.</p>
            </div>
        }
        else if (Model.questions.Count == 0)
        {
            <div class="empty">
                <svg class="icon" aria-hidden="true"><use href="#i-search"/></svg>
                <p class="mb-0">No questions found for <strong>@Model.Search</strong>. Try fewer or different words.</p>
            </div>
        }
        else
        {
            <p class="muted">
                @Model.TotalCount @(Model.TotalCount == 1 ? "question" : "questions") found for <strong>@Model.Search</strong>@(Model.TotalCount > Model.questions.Count ? $" (showing the first {Model.questions.Count}; refine your search to narrow it down)" : "").
            </p>
            <div class="q-list">
                @foreach (var question in Model.questions)
                {
                    var url = question.PaperID == 0
                        ? "/Question-Detail/" + question.QuestionID
                        : "/PPSC-Past-Paper-Question-Discussion/" + question.QuestionID;
                    @await Html.PartialAsync("_QuestionCard", new QuestionCardModel(question, number++, url))
                }
            </div>
        }
        </div>
    </div>
</div>
