@model Question
@{
    ViewBag.Title = Model.QuestionStatement + " | Nexam";
    ViewBag.KeyWords = Model.SubjectName + " | " + Model.QuestionStatement + " | " + Model.Choices + " | " + Model.CorrectAnswer;
    ViewBag.Description = Model.SubjectName + " | " + Model.QuestionStatement + " | " + Model.Choices + " | " + Model.CorrectAnswer;
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Options are not always populated on a single question: build them from the stored choices (English or Arabic comma).
    if (Model.Options == null || Model.Options.Count == 0)
    {
        Model.Options = (Model.Choices ?? "")
            .Split(new[] { ',', '،' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(c => new QuestionOption { Choice = c })
            .ToList();
    }
    var subject = string.IsNullOrWhiteSpace(Model.SubjectName) ? "Generic" : Model.SubjectName;
}

@section Head {
    <link rel="stylesheet" href="/css/pages-public.css" asp-append-version="true">
}

<div class="container">
    <div class="page-head">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/nexam/all-subjects">Subjects</a><span>/</span><a href="/Questions/@Model.SubjectID">@subject</a><span>/</span><span aria-current="page">Question</span></nav>
        <h1>Question discussion</h1>
        <p>Subject: <a href="/Questions/@Model.SubjectID">@subject</a></p>
    </div>

    <div class="section discussion" style="padding-top:20px">
        <div class="meta-row">
            <a class="badge badge-muted" href="/Questions/@Model.SubjectID">More @subject questions</a>
        </div>

        <div class="q-list">
            @await Html.PartialAsync("_QuestionCard", new QuestionCardModel(Model, Model.QuestionID, null, ShowSubject: false))
        </div>

        <section class="comments" aria-labelledby="comments-title">
            <h2 id="comments-title">Discussion</h2>
            <div class="comments-box">
                <div id="disqus_thread"></div>
            </div>
        </section>
    </div>
</div>

