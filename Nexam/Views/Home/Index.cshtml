@model HomeViewModel
@{
    ViewBag.Title = "Nexam | PPSC, FPSC, NTS & CSS past papers and practice MCQs";
    ViewBag.Description = "Nexam is a free exam-preparation platform: solved PPSC, FPSC, NTS and CSS past papers and practice MCQs for every subject, kept up to date.";
    ViewBag.KeyWords = "PPSC past papers, FPSC, NTS, CSS, MCQs, General Knowledge, Pak Studies, Islamiat, English, Mathematics, Current Affairs";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var latestYear = Model.RecentPpscYears.FirstOrDefault()?.Year;
}

<section class="hero">
    <div class="container">
        <h1>Prepare smarter for PPSC, FPSC, NTS &amp; CSS</h1>
        <p class="lead">Solved past papers and practice MCQs for every subject. Free, up to date, and built for revising on your phone.</p>

        <form class="hero-search" action="/Home/SearchResult" method="get" role="search" data-suggest="/Home/SearchSuggest">
            <input class="input" type="search" name="search" placeholder="Search any question" aria-label="Search questions" data-search-input>
            <select class="select" name="subject" aria-label="Subject">
                <option value="">All subjects</option>
                @foreach (var s in Model.SubjectList.Where(x => SubjectGroups.Of(x.SubjectName) == SubjectGroups.General))
                {
                    <option value="@s.SubjectID">@s.SubjectName</option>
                }
            </select>
        </form>

        <div class="hero-stats">
            <div><strong>@Model.PPSCList.Count</strong><span>PPSC past papers</span></div>
            <div><strong>@Model.SubjectList.Count</strong><span>Subjects</span></div>
            @if (latestYear != null)
            {
                <div><strong>@latestYear</strong><span>Latest papers</span></div>
            }
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-head">
            <div>
                <h2>Latest PPSC past papers</h2>
                <p>Newest papers first, with answers.</p>
            </div>
            <a class="btn btn-secondary btn-sm" href="/PPSC-Past-Papers">View all papers <svg class="icon" aria-hidden="true"><use href="#i-arrow-right"/></svg></a>
        </div>

        <div class="grid-cards">
            @foreach (var paper in Model.PPSCList.Take(6))
            {
                @await Html.PartialAsync("_PaperCard", new PaperCardModel(paper, Url.Content("~/PPSC-Past-Paper-Question/" + paper.PaperID), paper.PaperYear ?? "Recent", "Post: " + (paper.PaperPost ?? "Generic")))
            }
        </div>

        @if (Model.RecentPpscYears.Count > 0)
        {
            <div class="cluster mt-3">
                <span class="muted">Browse by year:</span>
                @foreach (var y in Model.RecentPpscYears)
                {
                    <a class="chip" href="/PPSC/SearchPPSCPaperYearwise?yearid=@y.YearID">@y.Year</a>
                }
                <a class="chip" href="/PPSC-Past-Papers">All years</a>
            </div>
        }
    </div>
</section>

<section class="section" style="padding-top:0">
    <div class="container">
        <div class="section-head">
            <div>
                <h2>Practice by subject</h2>
                <p>Thousands of MCQs, grouped by subject.</p>
            </div>
            <a class="btn btn-secondary btn-sm" href="/nexam/all-subjects">All subjects <svg class="icon" aria-hidden="true"><use href="#i-arrow-right"/></svg></a>
        </div>
        <div class="grid-cards">
            @foreach (var subject in Model.SubjectList.Take(9))
            {
                @await Html.PartialAsync("_SubjectCard", subject)
            }
        </div>
    </div>
</section>

<section class="section" style="padding-top:0">
    <div class="container">
        <div class="section-head"><div><h2>More exams</h2></div></div>
        <div class="feature-grid">
            <a class="feature" href="/NTS-Past-Papers" style="color:inherit">
                <div class="tile"><svg class="icon" aria-hidden="true"><use href="#i-file-text"/></svg></div>
                <h3>NTS past papers</h3><p class="muted mb-0">@Model.NTSList.Count papers to practise with.</p>
            </a>
            <a class="feature" href="/FPSC-Past-Papers" style="color:inherit">
                <div class="tile"><svg class="icon" aria-hidden="true"><use href="#i-file-text"/></svg></div>
                <h3>FPSC past papers</h3><p class="muted mb-0">@Model.FPSCList.Count papers to practise with.</p>
            </a>
            <a class="feature" href="/CSS-Past-Papers" style="color:inherit">
                <div class="tile"><svg class="icon" aria-hidden="true"><use href="#i-file-text"/></svg></div>
                <h3>CSS past papers</h3><p class="muted mb-0">@Model.CSSList.Count papers to study.</p>
            </a>
        </div>
    </div>
</section>

<section class="section" style="padding-top:0">
    <div class="container">
        <div class="cta-band">
            <div>
                <h2>Test yourself with a quiz</h2>
                <p>Pick a subject, choose how many questions, and see your score straight away. Free with an account.</p>
            </div>
            <a class="btn btn-secondary btn-lg" href="/Quiz/QuizHome">Start a quiz <svg class="icon" aria-hidden="true"><use href="#i-arrow-right"/></svg></a>
        </div>
    </div>
</section>
