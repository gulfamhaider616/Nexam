@model IEnumerable<Paper>
@{
	ViewBag.Title = "NewCSSQuestion";
	Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@section Head {
	<link rel="stylesheet" href="/css/pages-admin.css">
}
@section Scripts {
	<script src="https://cdn.ckeditor.com/ckeditor5/11.0.1/classic/ckeditor.js"></script>
	<script>
		(function () {
			var el = document.getElementById('questionstatement');
			if (el && window.ClassicEditor) {
				ClassicEditor.create(el).catch(function (err) { console.error(err); });
			}
		})();
	</script>
}

<div class="page-head">
	<h1>Add new CSS questions</h1>
	<p>Attach question text to an existing CSS paper.</p>
</div>

<div class="form-card wide mt-3">
	<form action="/CSS/SaveNewCSSQuestion" method="post">
		<div class="field">
			<label for="paperid">Paper</label>
			<select class="select" name="paperid" id="paperid">
				@foreach (var Item in Model)
				{
					<option value="@Item.PaperID">@Item.PaperName</option>
				}
			</select>
		</div>
		<div class="field">
			<label for="questionstatement">Question paper</label>
			<textarea class="textarea" name="questionstatement" id="questionstatement" rows="18" style="min-height:340px"></textarea>
			<span class="help">The content may contain HTML.</span>
		</div>
		<div class="form-actions">
			<button type="submit" class="btn btn-primary">Save questions</button>
			<a class="btn btn-secondary" href="/CSS/CSS_Home">Cancel</a>
		</div>
	</form>
</div>
