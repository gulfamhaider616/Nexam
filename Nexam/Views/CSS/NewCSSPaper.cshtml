@{
	ViewBag.Title = "NewCSSPaper";
	Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@section Head {
	<link rel="stylesheet" href="/css/pages-admin.css">
}
@section Scripts {
	<script src="https://cdn.ckeditor.com/ckeditor5/11.0.1/classic/ckeditor.js"></script>
	<script>
		(function () {
			var el = document.getElementById('questionstatement');
			if (el && window.ClassicEditor) {
				ClassicEditor.create(el).catch(function (err) { console.error(err); });
			}
		})();
	</script>
}

<div class="page-head">
	<h1>Add new CSS paper</h1>
	<p>Fill in the paper details and paste or type the question paper below. HTML formatting is kept.</p>
</div>

<div class="form-card wide mt-3">
	<form action="/CSS/SaveCSSNewPaper" method="post">
		<div class="field">
			<label for="name">Paper name</label>
			<input class="input" type="text" name="name" id="name" placeholder="Enter paper name">
		</div>
		<div class="field">
			<label for="detail">Paper detail</label>
			<input class="input" type="text" name="detail" id="detail" placeholder="Enter one line paper detail">
		</div>
		<div class="field">
			<label for="questionstatement">Question paper</label>
			<textarea class="textarea" name="questionstatement" id="questionstatement" rows="18" style="min-height:340px"></textarea>
			<span class="help">The content may contain HTML.</span>
		</div>
		<div class="form-actions">
			<button type="submit" class="btn btn-primary">Save paper</button>
			<a class="btn btn-secondary" href="/CSS/CSS_Home">Cancel</a>
		</div>
	</form>
</div>
