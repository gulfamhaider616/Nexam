@model QuestionListViewModel
@{
    var paper = Model.PaperDetail;
    var paperName = string.IsNullOrWhiteSpace(paper?.PaperName) ? "CSS Past Paper" : paper.PaperName;
    var papers = Model.PaperList ?? new List<Paper>();
    ViewBag.Title = paperName + " | Nexam";
    ViewBag.Description = $"Read {paperName}: CSS past paper with full questions. Nexam measures your improvement against the exam requirement and gives you constant feedback and guidance.";
    ViewBag.KeyWords = "CSS,PPSC Past Papers,All Past Papers, CSS Past Papers,Terms and conditions,Question,Subjects,nexam contact,Contact,Nexam,About nexam,MCQ,MCQS,CSS,CSS,PPSC,MCQ Preparation,General Knowledge,Pak study,Islamic Study,PAK AFFAIRS,MATHEMATIC,INTERNATIONAL AFFAIRS,COMPUTER SCIENCE,ENGLISH,GEOGRAPHY";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {
    <link rel="stylesheet" href="/css/pages-public.css">
}

<div class="container">
    <div class="page-head">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/CSS-Past-Papers">CSS Past Papers</a><span>/</span><span aria-current="page">@paperName</span></nav>
        <h1>@paperName</h1>
        @if (!string.IsNullOrWhiteSpace(paper?.PaperDetail))
        {
            <p>@paper.PaperDetail</p>
        }
    </div>

    <div class="section layout-sidebar" style="padding-top:20px">
        <div>
            <article class="card">
                <div class="card-body prose paper-text" dir="auto">
                    @Html.Raw(paper?.QuestionsText)
                </div>
            </article>

            <section class="comments" aria-labelledby="comments-title">
                <h2 id="comments-title">Discussion</h2>
                <div class="comments-box">
                    <div id="disqus_thread"></div>
                </div>
            </section>
        </div>

        <aside class="sticky stack" style="--gap:16px">
            <form class="panel" action="/Home/SearchResult" method="get" role="search">
                <h3>Search all questions</h3>
                <div class="field mb-0"><input class="input" type="search" name="search" placeholder="Search…" aria-label="Search questions"></div>
            </form>
            <div class="panel">
                <h3>All CSS papers</h3>
                <nav class="side-links" aria-label="CSS papers">
                    @foreach (var item in papers)
                    {
                        <a href="/CSS-Past-Paper-Question/@item.PaperID" aria-current="@(paper != null && item.PaperID == paper.PaperID ? "page" : null)">@item.PaperName</a>
                    }
                </nav>
            </div>
        </aside>
    </div>
</div>

