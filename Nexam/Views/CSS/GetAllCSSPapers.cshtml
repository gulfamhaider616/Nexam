@model IEnumerable<PaperDO>
@{
	ViewBag.Title = "Nexam | CSS Past Papers";
	ViewBag.Description = "Online Nexam measures your improvement against the exam requirement and provides you with constant feedback and guidance....";
	ViewBag.KeyWords = "CSS Past Paper,All Past Papers, CSS Past Papers,Add Question,Terms and conditions,Question,Subjects,nexam contact,Contact,Nexam,About nexam,MCQ,MCQS,CSS,CSS,PPSC,MCQ Preperation,General Knowledge,Pak study,Islamic Study,PAK AFFAIRS,MATHEMATIC,INTERNATIONAL AFFAIRS,COMPUTER SCIENCE,ENGLISH,GEOGRAPHY";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="main_bg">
	<!-- start main -->
	<div class="container">
		<div class="main row">
			@foreach (var Item in Model)
            {
				<div class="col-md-3 images_1_of_4 text-center" style="border: 1px solid #ff5454;border-radius: 10px;">
					<h4><a href="~/CSS-Past-Paper-Question/@Item.PaperID">@Item.PaperName</a></h4>
					@*<p class="para">@Item.PaperDetail</p>*@
					<a href="~/CSS-Past-Paper-Question/@Item.PaperID" class="fa-btn btn-1 btn-1e">Get Started</a>
				</div>
            }
		</div>
	</div>
</div><!-- end main -->
